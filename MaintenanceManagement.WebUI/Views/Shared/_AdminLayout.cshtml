                            Rol Yönetimi
                        </h6>

                        <a class="collapse-item"
                           asp-area="Admin"
                           asp-controller="Role"
                           asp-action="Index">

                            Rol Listesi

                        </a>

                        <a class="collapse-item"
                           asp-area="Admin"
                           asp-controller="Role"
                           asp-action="Create">

                            Yeni Rol Oluştur

                        </a>

                    </div>

                </div>

            </li>


            <!-- ===================================== -->
            <!-- MALZEME YÖNETİMİ -->
            <!-- ===================================== -->

            <li class="nav-item @(isMaterialManagement ? "active" : "")">

                <a class="nav-link @(isMaterialManagement ? "" : "collapsed")"
                   href="#"
                   data-toggle="collapse"
                   data-target="#collapseMaterials"
                   aria-expanded="@(isMaterialManagement ? "true" : "false")"
