@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool isUserManagement =
        controller == "User" &&
        (action == "Index" ||
         action == "Register" ||
         action == "Edit" ||
         action == "Details");

    bool isRoleManagement = controller == "Role";

    // Malzeme Tanıtımı, Malzeme Kategorileri ve Ölçü Birimleri aynı menüye bağlıdır.
    bool isMaterialManagement =
        controller == "Material" ||
        controller == "MaterialCategory" ||
        controller == "MeasurementUnit";

    // Ambar Tanıtımı ve Ambar Hareketleri aynı menüye bağlıdır.
    bool isWarehouseManagement =
        controller == "Warehouse" ||
        controller == "StockMovement" ||
        controller == "WarehouseTransfer" ||
        controller == "WarehouseStock";

    // Demirbaş Tanıtımı, Kategori, Marka ve Model sayfaları.
    // Demirbaş detay sayfası da AssetWizard controller'ını kullanır.
    bool isAssetManagement =
        controller == "AssetWizard" ||
        controller == "AssetDefinitions" ||
        controller == "Assets" ||
        controller == "AssetKinds" ||
        controller == "AssetPlaces";

    // Birim Yönetimi
    bool isUnitManagement = controller == "Unit";

    bool isProfile =
        controller == "User" &&
        (action == "Profile" ||
         action == "ProfileEdit" ||
         action == "ChangePassword");
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8">

    <meta http-equiv="X-UA-Compatible"
          content="IE=edge">

    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <meta name="description"
          content="Demirbaş ve Bakım Yönetim Sistemi">

    <meta name="author" content="">

    <title>
        @ViewData["Title"] - Demirbaş ve Bakım Yönetim Sistemi
    </title>

    <!-- Custom Fonts -->
    <link href="~/tema/vendor/fontawesome-free/css/all.min.css"
          rel="stylesheet"
          type="text/css">

    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900"
          rel="stylesheet">

    <!-- SB Admin 2 CSS -->
    <link href="~/tema/css/sb-admin-2.min.css"
          rel="stylesheet">

    <style>
            /* Yalnızca Ambar Yönetimi menüsü: uzun metinler taşmasın. */
            #collapseWarehouses .collapse-inner {
                max-width: 100%;
            }

            #collapseWarehouses .collapse-item {
                white-space: normal;
                line-height: 1.35;
                padding-top: .55rem;
                padding-bottom: .55rem;
            }
            /* Demirbaş alt menüsü de mevcut SB Admin 2 görünümünü kullanır. */
            #collapseAssets .collapse-inner {
                max-width: 100%;
            }

            #collapseAssets .collapse-item {
                white-space: normal;
                line-height: 1.35;
                padding-top: .55rem;
                padding-bottom: .55rem;
            }

                #collapseAssets .collapse-item.active {
                    font-weight: 700;
                }
    </style>
    @* ===============================================================
       V8.6 - ORTAK YÖNETİM PANELİ GÖRÜNÜMÜ
       Yalnızca ortak stiller; diğer sayfaların özel CSS'lerini ezmez.
       =============================================================== *@
    <style>
        :root { --admin-brand: #245bd6; --admin-border: #dce6f6; }
        #content-wrapper { background: #f3f7ff; }
        #content-wrapper .card,
        #content-wrapper .aw-card:not(.adv-page .aw-card) {
            border-color: var(--admin-border);
        }
        #content-wrapper .card { border-radius: .75rem; }
        #content-wrapper .btn { transition: filter .15s ease, box-shadow .15s ease; }
        #content-wrapper .btn:focus-visible,
        #content-wrapper a:focus-visible,
        #content-wrapper button:focus-visible {
            outline: 3px solid rgba(36, 91, 214, .33);
            outline-offset: 2px;
        }
        #content-wrapper .table-responsive { -webkit-overflow-scrolling: touch; }
        #collapseAssets .collapse-item.active {
            background-color: #e8efff;
            color: #2258ca;
            border-radius: .35rem;
        }
        @@media (prefers-reduced-motion: reduce) {
            #content-wrapper .btn { transition: none; }
        }
    </style>

    @* V8.7: BÜTÜN Admin sayfaları için ortak tema. Özel sayfa CSS dosyaları bundan sonra yüklenir. *@
    <link rel="stylesheet" href="~/css/admin-unified-premium.css" asp-append-version="true" />

    @* Demirbaş ekranlarının stil dosyalarını merkezi olarak yükle.
       Sayfadaki mevcut Styles bölümüne dokunulması gerekmez.
       Aynı CSS iki kere eklenirse kurallar aynıdır; fonksiyon bozulmaz. *@
    @if (controller == "Assets")
    {
        <link rel="stylesheet" href="~/css/asset-catalog.css" asp-append-version="true" />
    }
    else if (controller == "AssetWizard" && action == "Details")
    {
        <link rel="stylesheet" href="~/css/asset-catalog.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/asset-detail-visual.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/asset-detail-premium.css" asp-append-version="true" />
    }
    else if (controller == "AssetWizard")
    {
        <link rel="stylesheet" href="~/css/asset-wizard.css" asp-append-version="true" />
    }

    @RenderSection("Styles", required: false)
</head>

<body id="page-top" class="admin-unified-premium">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- ===================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================== -->

        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion"
