@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool isUserManagement =
        controller == "User" &&
        (action == "Index" ||
         action == "Register" ||
         action == "Edit" ||
         action == "Details");

    bool isRoleManagement = controller == "Role";

    // Malzeme Tanıtımı, Malzeme Kategorileri ve Ölçü Birimleri aynı menüye bağlıdır.
    bool isMaterialManagement =
        controller == "Material" ||
        controller == "MaterialCategory" ||
        controller == "MeasurementUnit";

    // Ambar Tanıtımı ve Ambar Hareketleri aynı menüye bağlıdır.
    bool isWarehouseManagement =
        controller == "Warehouse" ||
        controller == "StockMovement" ||
        controller == "WarehouseTransfer" ||
        controller == "WarehouseStock";

    // Birim Yönetimi
    bool isUnitManagement = controller == "Unit";

    bool isProfile =
        controller == "User" &&
        (action == "Profile" ||
         action == "ProfileEdit" ||
         action == "ChangePassword");
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8">

    <meta http-equiv="X-UA-Compatible"
          content="IE=edge">

    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <meta name="description"
          content="Demirbaş ve Bakım Yönetim Sistemi">

    <meta name="author" content="">

    <title>
        @ViewData["Title"] - Demirbaş ve Bakım Yönetim Sistemi
    </title>

    <!-- Custom Fonts -->
    <link href="~/tema/vendor/fontawesome-free/css/all.min.css"
          rel="stylesheet"
          type="text/css">

    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900"
          rel="stylesheet">

    <!-- SB Admin 2 CSS -->
    <link href="~/tema/css/sb-admin-2.min.css"
          rel="stylesheet">

    <style>
      /* Yalnızca Ambar Yönetimi menüsü: uzun metinler taşmasın. */
      #collapseWarehouses .collapse-inner { max-width: 100%; }
      #collapseWarehouses .collapse-item { white-space: normal; line-height: 1.35; padding-top: .55rem; padding-bottom: .55rem; }
    </style>
    @RenderSection("Styles", required: false)
</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- ===================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================== -->

        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion"
            id="accordionSidebar">

            <!-- Sidebar Brand -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center"
               asp-area="Admin"
               asp-controller="Home"
               asp-action="Index">

                <div class="sidebar-brand-icon rotate-n-15">
                    <i class="fas fa-tools"></i>
                </div>

                <div class="sidebar-brand-text mx-3">
                    Demirbaş &amp; Bakım
                </div>

            </a>

            <hr class="sidebar-divider my-0">

            <!-- Dashboard -->
            <li class="nav-item">

                <a class="nav-link"
                   asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <i class="fas fa-fw fa-tachometer-alt"></i>
                    <span>Dashboard</span>

                </a>

            </li>

            <hr class="sidebar-divider">

            <!-- ===================================== -->
            <!-- YÖNETİM İŞLEMLERİ -->
            <!-- ===================================== -->

            <div class="sidebar-heading">
                Yönetim İşlemleri
            </div>

            @* @if (User.IsInRole("Admin"))
            { *@
            <!-- ===================================== -->
            <!-- KULLANICI YÖNETİMİ -->
            <!-- ===================================== -->

            <li class="nav-item @(isUserManagement ? "active" : "")">

                <a class="nav-link"
                   asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index">

                    <i class="fas fa-fw fa-users"></i>
                    <span>Kullanıcı Yönetimi</span>

                </a>

            </li>

            <!-- ===================================== -->
            <!-- BİRİM YÖNETİMİ -->
            <!-- ===================================== -->

            <li class="nav-item @(isUnitManagement ? "active" : "")">

                <a class="nav-link"
                   asp-area="Admin"
                   asp-controller="Unit"
                   asp-action="Index">

                    <i class="fas fa-fw fa-sitemap"></i>
                    <span>Birim Yönetimi</span>

                </a>

            </li>

            <!-- ===================================== -->
            <!-- ROL YÖNETİMİ -->
            <!-- ===================================== -->

            <li class="nav-item @(isRoleManagement ? "active" : "")">

                <a class="nav-link @(isRoleManagement ? "" : "collapsed")"
                   href="#"
                   data-toggle="collapse"
                   data-target="#collapseRoles"
                   aria-expanded="@(isRoleManagement ? "true" : "false")"
                   aria-controls="collapseRoles">

                    <i class="fas fa-fw fa-user-shield"></i>
                    <span>Roller</span>

                </a>

                <div id="collapseRoles"
                     class="collapse @(isRoleManagement ? "show" : "")"
                     data-parent="#accordionSidebar">

                    <div class="bg-white py-2 collapse-inner rounded">

                        <h6 class="collapse-header">
                            Rol Yönetimi
                        </h6>

                        <a class="collapse-item"
                           asp-area="Admin"
                           asp-controller="Role"
                           asp-action="Index">

                            Rol Listesi

                        </a>

                        <a class="collapse-item"
                           asp-area="Admin"
                           asp-controller="Role"
                           asp-action="Create">

                            Yeni Rol Oluştur

                        </a>

                    </div>

                </div>

            </li>


            <!-- ===================================== -->
            <!-- MALZEME YÖNETİMİ -->
            <!-- ===================================== -->

            <li class="nav-item @(isMaterialManagement ? "active" : "")">

                <a class="nav-link @(isMaterialManagement ? "" : "collapsed")"
                   href="#"
                   data-toggle="collapse"
                   data-target="#collapseMaterials"
                   aria-expanded="@(isMaterialManagement ? "true" : "false")"
                   aria-controls="collapseMaterials">

                    <i class="fas fa-fw fa-boxes"></i>
                    <span>Malzeme Yönetimi</span>

                </a>

                <div id="collapseMaterials"
                     class="collapse @(isMaterialManagement ? "show" : "")"
                     data-parent="#accordionSidebar">

                    <div class="bg-white py-2 collapse-inner rounded">

                        <h6 class="collapse-header">
                            Malzeme Yönetimi
                        </h6>

                        <a class="collapse-item @(controller == "Material" ? "active" : "")"
                           asp-area="Admin"
                           asp-controller="Material"
                           asp-action="Index">

                            Malzeme Tanıtımı

                        </a>

                        <a class="collapse-item @(controller == "MaterialCategory" ? "active" : "")"
                           asp-area="Admin"
                           asp-controller="MaterialCategory"
                           asp-action="Index">

                            Malzeme Kategorileri

                        </a>

                        <a class="collapse-item @(controller == "MeasurementUnit" ? "active" : "")"
                           asp-area="Admin"
                           asp-controller="MeasurementUnit"
                           asp-action="Index">

                            Ölçü Birimleri

                        </a>

                    </div>

                </div>

            </li>


            <!-- ===================================== -->
            <!-- AMBAR YÖNETİMİ -->
            <!-- ===================================== -->

            <li class="nav-item @(isWarehouseManagement ? "active" : "")">

                <a class="nav-link @(isWarehouseManagement ? "" : "collapsed")"
                   href="#"
                   data-toggle="collapse"
                   data-target="#collapseWarehouses"
                   aria-expanded="@(isWarehouseManagement ? "true" : "false")"
                   aria-controls="collapseWarehouses">

                    <i class="fas fa-fw fa-warehouse"></i>
                    <span>Ambar Yönetimi</span>

                </a>

                <div id="collapseWarehouses"
                     class="collapse @(isWarehouseManagement ? "show" : "")"
                     data-parent="#accordionSidebar">

                    <div class="bg-white py-2 collapse-inner rounded">

                        <h6 class="collapse-header">
                            Ambar Yönetimi
                        </h6>

                        <a class="collapse-item @(controller == "Warehouse" ? "active" : "")"
                           asp-area="Admin"
                           asp-controller="Warehouse"
                           asp-action="Index">

                            Ambar Tanıtımı

                        </a>

                        <a class="collapse-item @(controller == "StockMovement" && action == "Index" ? "active" : "")"
                           asp-area="Admin" asp-controller="StockMovement" asp-action="Index">
                            <i class="fas fa-th-large fa-fw mr-1"></i> Ambar Hareketleri
                        </a>
                        <div class="pl-3" style="border-left:2px solid #e8ecf5;margin-left:17px;">
                            <a class="collapse-item @(controller=="StockMovement" && action=="CreateIn" ? "active" : "")"
                               asp-area="Admin" asp-controller="StockMovement" asp-action="CreateIn">
                                <i class="fas fa-box-open fa-fw mr-1 text-success"></i> Stok Girişi
                            </a>
                            <a class="collapse-item @(controller=="StockMovement" && action=="CreateOut" ? "active" : "")"
                               asp-area="Admin" asp-controller="StockMovement" asp-action="CreateOut">
                                <i class="fas fa-dolly fa-fw mr-1 text-danger"></i> Stok Çıkışı
                            </a>
                            <a class="collapse-item @(controller=="WarehouseTransfer" ? "active" : "")"
                               asp-area="Admin" asp-controller="WarehouseTransfer" asp-action="Index">
                                <i class="fas fa-exchange-alt fa-fw mr-1 text-primary"></i> Ambarlar Arası Transfer
                            </a>
                            <a class="collapse-item @(controller=="StockMovement" && action=="History" ? "active" : "")"
                               asp-area="Admin" asp-controller="StockMovement" asp-action="History">
                                <i class="fas fa-history fa-fw mr-1"></i> Hareket Geçmişi
                            </a>
                            <a class="collapse-item @(controller=="StockMovement" && action=="WorkOrderUsages" ? "active" : "")"
                               asp-area="Admin" asp-controller="StockMovement" asp-action="WorkOrderUsages">
                                <i class="fas fa-clipboard-list fa-fw mr-1"></i> İş Emri Malzeme Kullanımları
                            </a>
                        </div>
                        <a class="collapse-item @(controller == "WarehouseStock" ? "active" : "")"
                           asp-area="Admin" asp-controller="WarehouseStock" asp-action="Index">
                            <i class="fas fa-chart-bar fa-fw mr-1"></i> Stok Raporları
                        </a>
                    </div>

                </div>

            </li>


            @*  } *@




            <hr class="sidebar-divider d-none d-md-block">

            <!-- Sidebar Toggler -->
            <div class="text-center d-none d-md-inline">

                <button class="rounded-circle border-0"
                        id="sidebarToggle">
                </button>

            </div>

        </ul>

        <!-- End of Sidebar -->
        <!-- ===================================== -->
        <!-- CONTENT WRAPPER -->
        <!-- ===================================== -->

        <div id="content-wrapper"
             class="d-flex flex-column">

            <div id="content">

                <!-- ===================================== -->
                <!-- TOPBAR -->
                <!-- ===================================== -->

                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

                    <!-- Sidebar Toggle -->
                    <button id="sidebarToggleTop"
                            class="btn btn-link d-md-none rounded-circle mr-3">

                        <i class="fa fa-bars"></i>

                    </button>

                    <!-- Topbar Search -->
                    <form class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search">

                        <div class="input-group">

                            <input type="text"
                                   class="form-control bg-light border-0 small"
                                   placeholder="Ara..."
                                   aria-label="Search">

                            <div class="input-group-append">

                                <button class="btn btn-primary"
                                        type="button">

                                    <i class="fas fa-search fa-sm"></i>

                                </button>

                            </div>

                        </div>

                    </form>

                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">

                        <!-- Alerts -->
                        <li class="nav-item dropdown no-arrow mx-1">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="alertsDropdown"
                               role="button"
                               data-toggle="dropdown"
                               aria-haspopup="true"
                               aria-expanded="false">

                                <i class="fas fa-bell fa-fw"></i>

                            </a>

                            <div class="dropdown-list dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="alertsDropdown">

                                <h6 class="dropdown-header">
                                    Bildirimler
                                </h6>

                                <div class="dropdown-item text-center small text-gray-500">
                                    Yeni bildirim bulunmamaktadır.
                                </div>

                            </div>

                        </li>

                        <!-- Messages -->
                        <li class="nav-item dropdown no-arrow mx-1">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="messagesDropdown"
                               role="button"
                               data-toggle="dropdown"
                               aria-haspopup="true"
                               aria-expanded="false">

                                <i class="fas fa-envelope fa-fw"></i>

                            </a>

                            <div class="dropdown-list dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="messagesDropdown">

                                <h6 class="dropdown-header">
                                    Mesajlar
                                </h6>

                                <div class="dropdown-item text-center small text-gray-500">
                                    Yeni mesaj bulunmamaktadır.
                                </div>

                            </div>

                        </li>

                        <div class="topbar-divider d-none d-sm-block"></div>

                        <!-- ===================================== -->
                        <!-- USER INFORMATION -->
                        <!-- ===================================== -->

                        <li class="nav-item dropdown no-arrow">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="userDropdown"
                               role="button"
                               data-toggle="dropdown"
                               aria-haspopup="true"
                               aria-expanded="false">

                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">
                                    @(User.Identity?.Name ?? "Kullanıcı")
                                </span>

                                <img class="img-profile rounded-circle"
                                     src="~/tema/img/undraw_profile.svg"
                                     alt="Profil">

                            </a>

                            <!-- Dropdown Menu -->
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="userDropdown">

                                <!-- Profilim -->
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="Profile">

                                    <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Profilim

                                </a>

                                <!-- Profil Düzenle -->
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="ProfileEdit">

                                    <i class="fas fa-user-edit fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Profil Düzenle

                                </a>

                                <!-- Şifre Değiştir -->
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="ChangePassword">

                                    <i class="fas fa-key fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Şifre Değiştir

                                </a>

                                <div class="dropdown-divider"></div>

                                <!-- Logout -->
                                <a class="dropdown-item"
                                   href="#"
                                   data-toggle="modal"
                                   data-target="#logoutModal">

                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Çıkış Yap

                                </a>

                            </div>

                        </li>

                    </ul>

                </nav>

                <!-- End of Topbar -->
                <!-- ===================================== -->
                <!-- PAGE CONTENT -->
                <!-- ===================================== -->
                @if (TempData["Success"] != null)
                {
                    <div class="container-fluid">
                        <div class="alert alert-success alert-dismissible fade show"
                             role="alert">

                            @TempData["Success"]

                            <button type="button"
                                    class="close"
                                    data-dismiss="alert"
                                    aria-label="Kapat">
                                <span aria-hidden="true">&times;</span>
                            </button>

                        </div>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="container-fluid">
                        <div class="alert alert-danger alert-dismissible fade show"
                             role="alert">

                            @TempData["Error"]

                            <button type="button"
                                    class="close"
                                    data-dismiss="alert"
                                    aria-label="Kapat">
                                <span aria-hidden="true">&times;</span>
                            </button>

                        </div>
                    </div>
                }

                @RenderBody()

                <!-- End of Page Content -->

            </div>

            <!-- End of Main Content -->
            <!-- ===================================== -->
            <!-- FOOTER -->
            <!-- ===================================== -->

            <footer class="sticky-footer bg-white">

                <div class="container my-auto">

                    <div class="copyright text-center my-auto">

                        <span>
                            &copy; @DateTime.Now.Year
                            Demirbaş ve Bakım Yönetim Sistemi
                        </span>

                    </div>

                </div>

            </footer>

            <!-- End of Footer -->

        </div>

        <!-- End of Content Wrapper -->

    </div>

    <!-- End of Page Wrapper -->
    <!-- ===================================== -->
    <!-- SCROLL TO TOP -->
    <!-- ===================================== -->

    <a class="scroll-to-top rounded"
       href="#page-top">

        <i class="fas fa-angle-up"></i>

    </a>

    <!-- ===================================== -->
    <!-- LOGOUT MODAL -->
    <!-- ===================================== -->

    <div class="modal fade"
         id="logoutModal"
         tabindex="-1"
         role="dialog"
         aria-labelledby="logoutModalLabel"
         aria-hidden="true">

        <div class="modal-dialog" role="document">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="logoutModalLabel">

                        Çıkış Yap

                    </h5>

                    <button class="close"
                            type="button"
                            data-dismiss="modal"
                            aria-label="Kapat">

                        <span aria-hidden="true">
                            &times;
                        </span>

                    </button>

                </div>

                <div class="modal-body">

                    Oturumunuzu kapatmak istediğinize
                    emin misiniz?

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            type="button"
                            data-dismiss="modal">

                        Vazgeç

                    </button>

                    <!-- Güvenli Logout -->
                    <form asp-area="Admin"
                          asp-controller="User"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="fas fa-sign-out-alt"></i>
                            Çıkış Yap

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================== -->
    <!-- JAVASCRIPT -->
    <!-- ===================================== -->
    <!-- Bootstrap Core JavaScript -->
    <script src="~/tema/vendor/jquery/jquery.min.js"></script>

    <script src="~/tema/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core Plugin -->
    <script src="~/tema/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- SB Admin 2 -->
    <script src="~/tema/js/sb-admin-2.min.js"></script>

    <!-- Chart.js -->
    <script src="~/tema/vendor/chart.js/Chart.min.js"></script>

    <!-- Page Level Scripts -->
    <script src="~/tema/js/demo/chart-area-demo.js"></script>

    <script src="~/tema/js/demo/chart-pie-demo.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
