                            </a>

                            <!-- Dropdown Menu -->
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="userDropdown">

                                <!-- Profilim -->
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="Profile">

                                    <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Profilim

                                </a>

                                <!-- Profil Düzenle -->
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="ProfileEdit">

                                    <i class="fas fa-user-edit fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Profil Düzenle

                                </a>

                                <!-- Şifre Değiştir -->
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="ChangePassword">

                                    <i class="fas fa-key fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Şifre Değiştir

                                </a>

                                <div class="dropdown-divider"></div>

                                <!-- Logout -->
                                <a class="dropdown-item"
                                   href="#"
                                   data-toggle="modal"
                                   data-target="#logoutModal">

                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Çıkış Yap

                                </a>

                            </div>

                        </li>

                    </ul>

                </nav>

                <!-- End of Topbar -->
                <!-- ===================================== -->
                <!-- PAGE CONTENT -->
                <!-- ===================================== -->
                @if (TempData["Success"] != null)
                {
                    <div class="container-fluid">
                        <div class="alert alert-success alert-dismissible fade show"
                             role="alert">

                            @TempData["Success"]

                            <button type="button"
                                    class="close"
                                    data-dismiss="alert"
                                    aria-label="Kapat">
                                <span aria-hidden="true">&times;</span>
                            </button>

                        </div>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="container-fluid">
                        <div class="alert alert-danger alert-dismissible fade show"
                             role="alert">

                            @TempData["Error"]

                            <button type="button"
                                    class="close"
                                    data-dismiss="alert"
                                    aria-label="Kapat">
                                <span aria-hidden="true">&times;</span>
                            </button>

                        </div>
                    </div>
                }

                @RenderBody()

                <!-- End of Page Content -->

            </div>

            <!-- End of Main Content -->
            <!-- ===================================== -->
            <!-- FOOTER -->
            <!-- ===================================== -->

            <footer class="sticky-footer bg-white">

                <div class="container my-auto">

                    <div class="copyright text-center my-auto">

                        <span>
                            &copy; @DateTime.Now.Year
                            Demirbaş ve Bakım Yönetim Sistemi
                        </span>

                    </div>

                </div>

            </footer>

            <!-- End of Footer -->

        </div>

        <!-- End of Content Wrapper -->

    </div>

    <!-- End of Page Wrapper -->
    <!-- ===================================== -->
    <!-- SCROLL TO TOP -->
    <!-- ===================================== -->

    <a class="scroll-to-top rounded"
       href="#page-top">

        <i class="fas fa-angle-up"></i>

    </a>

    <!-- ===================================== -->
    <!-- LOGOUT MODAL -->
    <!-- ===================================== -->

    <div class="modal fade"
         id="logoutModal"
         tabindex="-1"
         role="dialog"
         aria-labelledby="logoutModalLabel"
         aria-hidden="true">

        <div class="modal-dialog" role="document">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="logoutModalLabel">

                        Çıkış Yap

                    </h5>

                    <button class="close"
                            type="button"
                            data-dismiss="modal"
                            aria-label="Kapat">

                        <span aria-hidden="true">
                            &times;
                        </span>

                    </button>

                </div>

                <div class="modal-body">

                    Oturumunuzu kapatmak istediğinize
                    emin misiniz?

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            type="button"
                            data-dismiss="modal">

                        Vazgeç

                    </button>

                    <!-- Güvenli Logout -->
                    <form asp-area="Admin"
                          asp-controller="User"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="fas fa-sign-out-alt"></i>
                            Çıkış Yap

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================== -->
    <!-- JAVASCRIPT -->
    <!-- ===================================== -->
    <!-- Bootstrap Core JavaScript -->
    <script src="~/tema/vendor/jquery/jquery.min.js"></script>

    <script src="~/tema/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core Plugin -->
    <script src="~/tema/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- SB Admin 2 -->
    <script src="~/tema/js/sb-admin-2.min.js"></script>

    <!-- Chart.js -->
    <script src="~/tema/vendor/chart.js/Chart.min.js"></script>

    <!-- Page Level Scripts -->
    <script src="~/tema/js/demo/chart-area-demo.js"></script>

    <script src="~/tema/js/demo/chart-pie-demo.js"></script>

    @* V8.7: Bootstrap ve SB Admin 2 yüklemeleri tamamlandıktan sonra ortak yardımcı JS. *@
    <script src="~/js/admin-unified-premium.js" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Scripts", required: false)

    @* V8.6: Bir view kendi JS dosyasını Scripts bölümünde yüklediyse
       ikinci kez eklemeyerek çift event handler / iki kez submit riskini önler.
       Kök-relative URL çözümlemesi app VirtualDirectory altında da çalışır. *@
    @if (controller == "AssetWizard" && action == "Details")
    {
        <script>
            (function () {
                var relativePath = '@Url.Content("~/js/asset-detail-premium.js")';
                var alreadyLoaded = Array.prototype.some.call(document.scripts, function (s) {
                    return s.src && s.src.split('?')[0].endsWith('/js/asset-detail-premium.js');
                });
                if (!alreadyLoaded) {
                    var script = document.createElement('script');
                    script.src = relativePath;
                    script.defer = true;
                    document.body.appendChild(script);
                }
            })();
        </script>
    }
    else if (controller == "Assets" && action == "Index")
    {
        <script>
            (function () {
                var relativePath = '@Url.Content("~/js/asset-catalog-detail.js")';
                var alreadyLoaded = Array.prototype.some.call(document.scripts, function (s) {
                    return s.src && s.src.split('?')[0].endsWith('/js/asset-catalog-detail.js');
                });
                if (!alreadyLoaded) {
                    var script = document.createElement('script');
                    script.src = relativePath;
                    script.defer = true;
                    document.body.appendChild(script);
                }
            })();
        </script>
    }


</body>

</html>
