                    <i class="fas fa-tools"></i>
                </div>

                <div class="sidebar-brand-text mx-3">
                    Demirbaş &amp; Bakım
                </div>

            </a>

            <hr class="sidebar-divider my-0">

            <!-- Dashboard -->
            <li class="nav-item">

                <a class="nav-link"
                   asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <i class="fas fa-fw fa-tachometer-alt"></i>
                    <span>Dashboard</span>

                </a>

            </li>

            <hr class="sidebar-divider">

            <!-- ===================================== -->
            <!-- YÖNETİM İŞLEMLERİ -->
            <!-- ===================================== -->

            <div class="sidebar-heading">
                Yönetim İşlemleri
            </div>

            @* @if (User.IsInRole("Admin"))
            { *@
            <!-- ===================================== -->
            <!-- KULLANICI YÖNETİMİ -->
            <!-- ===================================== -->

            <li class="nav-item @(isUserManagement ? "active" : "")">

                <a class="nav-link"
                   asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index">

                    <i class="fas fa-fw fa-users"></i>
                    <span>Kullanıcı Yönetimi</span>

                </a>

            </li>

            <!-- ===================================== -->
            <!-- BİRİM YÖNETİMİ -->
            <!-- ===================================== -->

            <li class="nav-item @(isUnitManagement ? "active" : "")">

                <a class="nav-link"
                   asp-area="Admin"
                   asp-controller="Unit"
                   asp-action="Index">

                    <i class="fas fa-fw fa-sitemap"></i>
                    <span>Birim Yönetimi</span>

                </a>

            </li>

            <!-- ===================================== -->
            <!-- ROL YÖNETİMİ -->
            <!-- ===================================== -->

            <li class="nav-item @(isRoleManagement ? "active" : "")">

                <a class="nav-link @(isRoleManagement ? "" : "collapsed")"
