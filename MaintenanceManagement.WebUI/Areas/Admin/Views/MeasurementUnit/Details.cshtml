@model MaintenanceManagement.Application.DTOS.MeasurementUnitDtos.GetByIdMeasurementUnitDto

@{
    ViewData["Title"] = "Ölçü Birimi Detayları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- BAŞLIK -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <div>
            <h1 class="h3 mb-1 text-gray-800">
                Ölçü Birimi Detayları
            </h1>

            <p class="text-muted mb-0">
                @Model.Name (@Model.Symbol)
            </p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning btn-sm mr-2">

                <i class="fas fa-edit mr-1"></i>
                Güncelle
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary btn-sm">

                <i class="fas fa-arrow-left mr-1"></i>
                Listeye Dön
            </a>
        </div>

    </div>

    <!-- MESAJLAR -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="close"
                    data-dismiss="alert">

                <span>&times;</span>
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="close"
                    data-dismiss="alert">

                <span>&times;</span>
            </button>

        </div>
    }

    <!-- İSTATİSTİKLER -->
    <div class="row">

        <div class="col-xl-4 col-md-6 mb-4">

            <div class="card border-left-primary shadow-sm h-100 py-2">

                <div class="card-body">

                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                        Toplam Malzeme
                    </div>

                    <div class="h4 mb-0 font-weight-bold text-gray-800">
                        @Model.MaterialCount
                    </div>

                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-4">

            <div class="card border-left-success shadow-sm h-100 py-2">

                <div class="card-body">

                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                        Aktif Malzeme
                    </div>

                    <div class="h4 mb-0 font-weight-bold text-gray-800">
                        @Model.ActiveMaterialCount
                    </div>

                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-4">

            <div class="card border-left-secondary shadow-sm h-100 py-2">

                <div class="card-body">

                    <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">
                        Pasif Malzeme
                    </div>

                    <div class="h4 mb-0 font-weight-bold text-gray-800">
                        @Model.PassiveMaterialCount
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="row">

        <!-- DETAY BİLGİLERİ -->
        <div class="col-lg-8">

            <div class="card shadow-sm mb-4">

                <div class="card-header py-3">

                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-info-circle mr-2"></i>
                        Ölçü Birimi Bilgileri
                    </h6>

                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-4">
                            Kayıt ID
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Id
                        </dd>

                        <dt class="col-sm-4">
                            Ölçü Birimi
                        </dt>

                        <dd class="col-sm-8">
                            <strong>@Model.Name</strong>
                        </dd>

                        <dt class="col-sm-4">
                            Kısaltma
                        </dt>

                        <dd class="col-sm-8">
                            <span class="badge badge-light border p-2">
                                @Model.Symbol
                            </span>
                        </dd>

                        <dt class="col-sm-4">
                            Durum
                        </dt>

                        <dd class="col-sm-8">

                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success p-2">
                                    Aktif
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-secondary p-2">
                                    Pasif
                                </span>
                            }

                        </dd>

                        <dt class="col-sm-4">
                            Oluşturulma Tarihi
                        </dt>

                        <dd class="col-sm-8">
                            @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-4">
                            Güncellenme Tarihi
                        </dt>

                        <dd class="col-sm-8">

                            @(Model.UpdatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")

                        </dd>

                    </dl>

                </div>
            </div>

        </div>

        <!-- İŞLEMLER -->
        <div class="col-lg-4">

            <div class="card shadow-sm mb-4">

                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        İşlemler
                    </h6>
                </div>

                <div class="card-body">

                    <a asp-action="Materials"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary btn-block">

                        <i class="fas fa-boxes mr-1"></i>
                        Bağlı Malzemeleri Görüntüle

                    </a>

                    <form asp-action="ChangeStatus"
                          method="post"
                          class="mt-3 measurement-details-status-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <input type="hidden"
                               name="isActive"
                               value="@(!Model.IsActive)" />

                        <button type="submit"
                                class="btn btn-block @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">

                            <i class="fas @(Model.IsActive ? "fa-ban" : "fa-check") mr-1"></i>

                            @(Model.IsActive ? "Pasif Hale Getir" : "Aktif Hale Getir")

                        </button>
                    </form>

                </div>
            </div>

            <div class="card border-left-info shadow-sm mb-4">

                <div class="card-body">

                    <h6 class="font-weight-bold text-info">
                        <i class="fas fa-info-circle mr-1"></i>
                        Kullanım Kuralı
                    </h6>

                    <p class="small text-muted mb-0">
                        Aktif malzemelere bağlı ölçü birimleri
                        pasif hale getirilemez. Bu kontrol
                        MeasurementUnitService tarafından yapılır.
                    </p>

                </div>
            </div>

        </div>

    </div>
</div>

@section Scripts {

    <script>

        document.querySelectorAll(".measurement-details-status-form")
            .forEach(function (form) {

                form.addEventListener("submit", function (event) {

                    if (!confirm("Ölçü biriminin durumunu değiştirmek istiyor musunuz?")) {
                        event.preventDefault();
                    }

                });

            });

    </script>
}
