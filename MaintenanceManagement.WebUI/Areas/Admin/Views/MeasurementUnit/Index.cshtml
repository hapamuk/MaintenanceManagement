@model IReadOnlyList<MaintenanceManagement.Application.DTOS.MeasurementUnitDtos.ResultMeasurementUnitDto>

@using System.Linq

@{
    ViewData["Title"] = "Ölçü Birimleri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string searchText = ViewBag.SearchText as string
        ?? string.Empty;

    bool onlyActive = ViewBag.OnlyActive == true;

    string currentFilter = ViewBag.CurrentFilter as string
        ?? "All";

    var units = Model ?? Array.Empty<
        MaintenanceManagement.Application.DTOS.MeasurementUnitDtos.ResultMeasurementUnitDto>();
}

<div class="container-fluid">

    <!-- SAYFA BAŞLIĞI -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <div>
            <h1 class="h3 mb-1 text-gray-800">
                Ölçü Birimi Yönetimi
            </h1>

            <p class="text-muted mb-0">
                Malzeme işlemlerinde kullanılacak ölçü birimlerini yönetin.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="MeasurementUnit"
           asp-action="Create"
           class="btn btn-primary btn-sm shadow-sm">

            <i class="fas fa-plus mr-1"></i>
            Yeni Ölçü Birimi
        </a>
    </div>

    <!-- MESAJLAR -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="fas fa-check-circle mr-1"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="close"
                    data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="fas fa-exclamation-circle mr-1"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="close"
                    data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    <!-- ARAMA -->
    <div class="card shadow-sm mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-search mr-2"></i>
                Ölçü Birimi Arama
            </h6>
        </div>

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="MeasurementUnit"
                  asp-action="Search"
                  method="get">

                <div class="row align-items-end">

                    <div class="col-md-6 form-group">

                        <label class="font-weight-bold">
                            Ad veya Kısaltma
                        </label>

                        <input type="text"
                               name="searchText"
                               value="@searchText"
                               class="form-control"
                               placeholder="Örn. Kilogram veya kg..." />
                    </div>

                    <div class="col-md-3 form-group">

                        <div class="custom-control custom-checkbox mb-2">

                            <input type="checkbox"
                                   id="onlyActive"
                                   name="onlyActive"
                                   value="true"
                                   checked="@onlyActive"
                                   class="custom-control-input" />

                            <label class="custom-control-label"
                                   for="onlyActive">
                                Sadece Aktif Kayıtlar
                            </label>

                        </div>
                    </div>

                    <div class="col-md-3 form-group text-md-right">

                        <button type="submit" class="btn btn-primary">

                            <i class="fas fa-search mr-1"></i>
                            Ara
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Temizle
                        </a>

                    </div>
                </div>
            </form>

            <!-- HIZLI FİLTRELER -->
            <div class="d-flex flex-wrap mt-2" style="gap:6px;">

                <a asp-action="Index"
                   class="btn btn-sm @(currentFilter == "All" ? "btn-primary" : "btn-outline-primary")">
                    Tümü
                </a>

                <a asp-action="Active"
                   class="btn btn-sm @(currentFilter == "Active" ? "btn-success" : "btn-outline-success")">
                    Aktif
                </a>

                <a asp-action="Inactive"
                   class="btn btn-sm @(currentFilter == "Inactive" ? "btn-secondary" : "btn-outline-secondary")">
                    Pasif
                </a>

                <a asp-action="WithMaterials"
                   class="btn btn-sm @(currentFilter == "WithMaterials" ? "btn-info" : "btn-outline-info")">
                    Malzemesi Olanlar
                </a>

                <a asp-action="WithoutMaterials"
                   class="btn btn-sm @(currentFilter == "WithoutMaterials" ? "btn-dark" : "btn-outline-dark")">
                    Malzemesi Olmayanlar
                </a>

            </div>
        </div>
    </div>

    <!-- LİSTE -->
    <div class="card shadow-sm mb-4">

        <div class="card-header py-3 d-flex justify-content-between align-items-center">

            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-ruler-combined mr-2"></i>
                Ölçü Birimi Listesi
            </h6>

            <span class="badge badge-primary p-2">
                Toplam: @units.Count
            </span>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover"
                       width="100%"
                       cellspacing="0">

                    <thead class="thead-light">

                        <tr>
                            <th style="width:75px;">ID</th>
                            <th>Ölçü Birimi</th>
                            <th>Kısaltma</th>
                            <th>Malzeme Sayısı</th>
                            <th>Durum</th>
                            <th style="min-width:220px;">İşlemler</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (units.Any())
                        {
                            foreach (var item in units)
                            {
                                <tr>

                                    <td>@item.Id</td>

                                    <td>
                                        <strong>@item.Name</strong>
                                    </td>

                                    <td>
                                        <span class="badge badge-light border p-2">
                                            @item.Symbol
                                        </span>
                                    </td>

                                    <td>
                                        <a asp-action="Materials"
                                           asp-route-id="@item.Id"
                                           class="badge badge-info p-2">

                                            @item.MaterialCount

                                        </a>
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge badge-success p-2">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary p-2">
                                                Pasif
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        <div class="d-flex flex-wrap" style="gap:5px;">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-info btn-sm"
                                               title="Detay">

                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm"
                                               title="Güncelle">

                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <a asp-action="Materials"
                                               asp-route-id="@item.Id"
                                               class="btn btn-primary btn-sm"
                                               title="Bağlı Malzemeler">

                                                <i class="fas fa-boxes"></i>
                                            </a>

                                            <form asp-area="Admin"
                                                  asp-controller="MeasurementUnit"
                                                  asp-action="ChangeStatus"
                                                  method="post"
                                                  class="d-inline measurement-status-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <input type="hidden"
                                                       name="isActive"
                                                       value="@(!item.IsActive)" />

                                                <button type="submit"
                                                        class="btn btn-sm @(item.IsActive ? "btn-danger" : "btn-success")"
                                                        title="@(item.IsActive ? "Pasifleştir" : "Aktifleştir")">

                                                    <i class="fas @(item.IsActive ? "fa-ban" : "fa-check")"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">

                                    <i class="fas fa-info-circle mr-1"></i>
                                    Ölçü birimi kaydı bulunamadı.
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>

        document.querySelectorAll(".measurement-status-form")
            .forEach(function (form) {

                form.addEventListener("submit", function (event) {

                    const nextStatus = form.querySelector(
                        'input[name="isActive"]'
                    ).value.toLowerCase() === "true";

                    const message = nextStatus
                        ? "Ölçü birimini aktif hale getirmek istiyor musunuz?"
                        : "Ölçü birimini pasif hale getirmek istiyor musunuz? Aktif malzemelere bağlı ölçü birimleri pasifleştirilemez.";

                    if (!confirm(message)) {
                        event.preventDefault();
                    }

                });

            });

    </script>
}
