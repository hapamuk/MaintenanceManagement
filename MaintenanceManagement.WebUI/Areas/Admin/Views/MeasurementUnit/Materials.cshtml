@model IReadOnlyList<MaintenanceManagement.Application.DTOS.MaterialDtos.ResultMaterialDto>

@using System.Linq

@{
    ViewData["Title"] = "Ölçü Birimi Malzemeleri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int measurementUnitId = (int)ViewBag.MeasurementUnitId;

    string measurementUnitName =
        ViewBag.MeasurementUnitName as string
        ?? string.Empty;

    string measurementUnitSymbol =
        ViewBag.MeasurementUnitSymbol as string
        ?? string.Empty;

    bool onlyActive = ViewBag.OnlyActive == true;

    var materials = Model ?? Array.Empty<
        MaintenanceManagement.Application.DTOS.MaterialDtos.ResultMaterialDto>();
}

<div class="container-fluid">

    <!-- SAYFA BAŞLIĞI -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <div>
            <h1 class="h3 mb-1 text-gray-800">
                Ölçü Birimine Bağlı Malzemeler
            </h1>

            <p class="text-muted mb-0">
                @measurementUnitName (@measurementUnitSymbol)
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="MeasurementUnit"
           asp-action="Details"
           asp-route-id="@measurementUnitId"
           class="btn btn-outline-secondary btn-sm">

            <i class="fas fa-arrow-left mr-1"></i>
            Ölçü Birimi Detayı
        </a>

    </div>

    <!-- FİLTRE -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="MeasurementUnit"
                  asp-action="Materials"
                  asp-route-id="@measurementUnitId"
                  method="get">

                <div class="d-flex justify-content-between align-items-center flex-wrap">

                    <div class="custom-control custom-checkbox mb-2">

                        <input type="checkbox"
                               class="custom-control-input"
                               id="onlyActiveMaterials"
                               name="onlyActive"
                               value="true"
                               checked="@onlyActive" />

                        <label class="custom-control-label"
                               for="onlyActiveMaterials">

                            Yalnızca Aktif Malzemeler

                        </label>

                    </div>

                    <div>

                        <button type="submit"
                                class="btn btn-primary btn-sm">

                            <i class="fas fa-filter mr-1"></i>
                            Filtrele

                        </button>

                        <a asp-action="Materials"
                           asp-route-id="@measurementUnitId"
                           class="btn btn-secondary btn-sm">

                            Temizle

                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- MALZEME LİSTESİ -->
    <div class="card shadow-sm mb-4">

        <div class="card-header py-3 d-flex justify-content-between align-items-center">

            <h6 class="m-0 font-weight-bold text-primary">

                <i class="fas fa-boxes mr-2"></i>
                Malzeme Listesi

            </h6>

            <span class="badge badge-primary p-2">
                Toplam: @materials.Count
            </span>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover"
                       width="100%"
                       cellspacing="0">

                    <thead class="thead-light">

                        <tr>
                            <th>Malzeme Kodu</th>
                            <th>Malzeme Adı</th>
                            <th>Kategori</th>
                            <th>Minimum Stok</th>
                            <th>Durum</th>
                            <th style="width:100px;">İşlem</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (materials.Any())
                        {
                            foreach (var material in materials)
                            {
                                <tr>

                                    <td>
                                        <strong>@material.MaterialCode</strong>
                                    </td>

                                    <td>
                                        @material.Name
                                    </td>

                                    <td>
                                        @(material.MaterialCategoryName ?? "Belirtilmedi")
                                    </td>

                                    <td>
                                        @material.MinimumStockLevel.ToString("N3")
                                        <small class="text-muted">
                                            @measurementUnitSymbol
                                        </small>
                                    </td>

                                    <td>

                                        <span class="badge @(material.IsActive ? "badge-success" : "badge-secondary") p-2">

                                            @material.IsActiveName

                                        </span>

                                    </td>

                                    <td>

                                        <a asp-area="Admin"
                                           asp-controller="Material"
                                           asp-action="Details"
                                           asp-route-id="@material.Id"
                                           class="btn btn-info btn-sm">

                                            <i class="fas fa-eye mr-1"></i>
                                            Detay

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-4">

                                    <i class="fas fa-box-open mr-1"></i>

                                    Bu ölçü birimine bağlı malzeme bulunamadı.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>
</div>
