@model MaintenanceManagement.Application.DTOS.MeasurementUnitDtos.UpdateMeasurementUnitDto

@{
    ViewData["Title"] = "Ölçü Birimi Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- BAŞLIK -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <div>
            <h1 class="h3 mb-1 text-gray-800">
                Ölçü Birimi Güncelle
            </h1>

            <p class="text-muted mb-0">
                @Model.Name (@Model.Symbol)
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="MeasurementUnit"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary btn-sm">

            <i class="fas fa-arrow-left mr-1"></i>
            Ölçü Birimi Detayı
        </a>

    </div>

    <form asp-area="Admin"
          asp-controller="MeasurementUnit"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          autocomplete="off">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row">

            <div class="col-lg-8 col-xl-7">

                <div class="card shadow-sm mb-4">

                    <div class="card-header py-3">

                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="fas fa-edit mr-2"></i>
                            Ölçü Birimi Bilgileri
                        </h6>

                    </div>

                    <div class="card-body">

                        <div class="form-group">

                            <label asp-for="Name"
                                   class="font-weight-bold"></label>

                            <span class="text-danger">*</span>

                            <input asp-for="Name"
                                   class="form-control"
                                   maxlength="100" />

                            <span asp-validation-for="Name"
                                  class="text-danger small"></span>

                        </div>

                        <div class="form-group mb-0">

                            <label asp-for="Symbol"
                                   class="font-weight-bold"></label>

                            <span class="text-danger">*</span>

                            <input asp-for="Symbol"
                                   class="form-control"
                                   maxlength="20" />

                            <span asp-validation-for="Symbol"
                                  class="text-danger small"></span>

                        </div>

                    </div>
                </div>

            </div>

            <!-- BİLGİLENDİRME -->
            <div class="col-lg-4 col-xl-5">

                <div class="card border-left-warning shadow-sm mb-4">

                    <div class="card-body">

                        <h6 class="font-weight-bold text-warning">
                            <i class="fas fa-exclamation-triangle mr-1"></i>
                            Güncelleme Bilgisi
                        </h6>

                        <p class="small text-muted">
                            Ölçü birimi adı veya kısaltması değiştirildiğinde,
                            bu ölçü birimini kullanan malzemelerde güncel
                            bilgiler görüntülenir.
                        </p>

                        <p class="small text-muted mb-0">
                            Kaydın aktiflik durumu ve malzeme ilişkileri
                            güncelleme sırasında korunur.
                        </p>

                    </div>
                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-body text-right">

                <a asp-area="Admin"
                   asp-controller="MeasurementUnit"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary mr-2">

                    Vazgeç

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-save mr-1"></i>
                    Değişiklikleri Kaydet

                </button>

            </div>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
