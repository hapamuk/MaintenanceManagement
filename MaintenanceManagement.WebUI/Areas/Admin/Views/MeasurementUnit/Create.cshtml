@model MaintenanceManagement.Application.DTOS.MeasurementUnitDtos.CreateMeasurementUnitDto

@{
    ViewData["Title"] = "Yeni Ölçü Birimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- BAŞLIK -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <div>
            <h1 class="h3 mb-1 text-gray-800">
                Yeni Ölçü Birimi
            </h1>

            <p class="text-muted mb-0">
                Malzeme tanıtımında kullanılacak yeni ölçü birimini oluşturun.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="MeasurementUnit"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm">

            <i class="fas fa-arrow-left mr-1"></i>
            Listeye Dön
        </a>

    </div>

    <form asp-area="Admin"
          asp-controller="MeasurementUnit"
          asp-action="Create"
          method="post"
          autocomplete="off">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row">

            <!-- FORM -->
            <div class="col-lg-8 col-xl-7">

                <div class="card shadow-sm mb-4">

                    <div class="card-header py-3">

                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="fas fa-ruler mr-2"></i>
                            Ölçü Birimi Bilgileri
                        </h6>

                    </div>

                    <div class="card-body">

                        <div class="form-group">

                            <label asp-for="Name"
                                   class="font-weight-bold"></label>

                            <span class="text-danger">*</span>

                            <input asp-for="Name"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="Örn. Kilogram" />

                            <span asp-validation-for="Name"
                                  class="text-danger small"></span>

                            <small class="form-text text-muted">
                                Ölçü biriminin açıklayıcı adını giriniz.
                            </small>

                        </div>

                        <div class="form-group mb-0">

                            <label asp-for="Symbol"
                                   class="font-weight-bold"></label>

                            <span class="text-danger">*</span>

                            <input asp-for="Symbol"
                                   class="form-control"
                                   maxlength="20"
                                   placeholder="Örn. kg" />

                            <span asp-validation-for="Symbol"
                                  class="text-danger small"></span>

                            <small class="form-text text-muted">
                                Malzeme ve stok ekranlarında gösterilecek kısa ifadedir.
                            </small>

                        </div>

                    </div>
                </div>

            </div>

            <!-- BİLGİ ALANI -->
            <div class="col-lg-4 col-xl-5">

                <div class="card border-left-info shadow-sm mb-4">

                    <div class="card-body">

                        <h6 class="font-weight-bold text-info">
                            <i class="fas fa-info-circle mr-1"></i>
                            Kullanım Bilgisi
                        </h6>

                        <p class="small text-muted">
                            Ölçü birimleri sistem genelinde ortak kullanılır.
                            Yeni oluşturulan ölçü birimi aktif olacaktır.
                        </p>

                        <div class="small">

                            <div class="mb-2">
                                <strong>Adet</strong>
                                <span class="text-muted">— Adet</span>
                            </div>

                            <div class="mb-2">
                                <strong>Kilogram</strong>
                                <span class="text-muted">— kg</span>
                            </div>

                            <div class="mb-2">
                                <strong>Metre</strong>
                                <span class="text-muted">— m</span>
                            </div>

                            <div>
                                <strong>Litre</strong>
                                <span class="text-muted">— L</span>
                            </div>

                        </div>

                        <hr />

                        <p class="small text-muted mb-0">
                            Ölçü birimi adı ve kısaltması sistemde benzersiz olmalıdır.
                        </p>

                    </div>
                </div>

            </div>
        </div>

        <!-- KAYDET -->
        <div class="card shadow-sm mb-4">

            <div class="card-body text-right">

                <a asp-action="Index"
                   class="btn btn-outline-secondary mr-2">
                    Vazgeç
                </a>

                <button type="submit" class="btn btn-primary">

                    <i class="fas fa-save mr-1"></i>
                    Ölçü Birimini Kaydet

                </button>

            </div>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
    