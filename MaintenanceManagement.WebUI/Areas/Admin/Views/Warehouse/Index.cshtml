@model IReadOnlyList<MaintenanceManagement.Application.DTOS.WarehouseDtos.ResultWarehouseDto>
@{
    ViewData["Title"] = "Ambar Tanıtımı";
    var rows = Model ?? Array.Empty<MaintenanceManagement.Application.DTOS.WarehouseDtos.ResultWarehouseDto>();
    string? filter = ViewBag.CurrentFilter as string;
}
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
@section Styles { <link rel="stylesheet" href="~/css/warehouse-wizard.css" asp-append-version="true" /> }
<div class="container-fluid wh-page">
<div class="wh-header d-flex flex-wrap align-items-center justify-content-between"><div><h1 class="wh-title"><i class="fas fa-warehouse text-primary mr-2"></i> Ambar Tanıtımı</h1><p class="wh-subtitle">Organizasyon bazlı ambarlar ve görevli personel yönetimi</p></div><a asp-area="Admin" asp-controller="Warehouse" asp-action="Create" class="btn wh-btn-primary mt-2"><i class="fas fa-plus mr-2"></i>Yeni Ambar</a></div>
@if(TempData["SuccessMessage"] != null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}
@if(TempData["ErrorMessage"] != null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}
<div class="row mb-2"><div class="col-lg-4"><div class="wh-tile"><div class="wh-tile-body"><div class="wh-muted">Toplam Ambar</div><h3 class="font-weight-bold mb-0">@rows.Count</h3></div></div></div><div class="col-lg-4"><div class="wh-tile"><div class="wh-tile-body"><div class="wh-muted">Bu Listede Aktif</div><h3 class="font-weight-bold text-success mb-0">@rows.Count(x=>x.IsActive)</h3></div></div></div><div class="col-lg-4"><div class="wh-tile"><div class="wh-tile-body"><div class="wh-muted">Bu Listede Pasif</div><h3 class="font-weight-bold text-secondary mb-0">@rows.Count(x=>!x.IsActive)</h3></div></div></div></div>
<div class="wh-tile"><div class="wh-tile-body"><form asp-area="Admin" asp-controller="Warehouse" asp-action="Search" method="get" class="form-row align-items-end"><div class="col-md-6 mb-2"><label class="font-weight-bold small" for="searchText">Ambar Ara</label><input id="searchText" name="searchText" value="@ViewBag.SearchText" placeholder="Ambar adı veya kodu..." class="form-control" /></div><div class="col-md-3 mb-2"><label class="font-weight-bold small" for="onlyActive">Durum Filtresi</label><select id="onlyActive" name="onlyActive" class="form-control"><option value="false">Tümü</option><option value="true">Yalnızca aktif</option></select></div><div class="col-md-3 mb-2"><button class="btn wh-btn-primary" type="submit"><i class="fas fa-search"></i> Ara</button><a asp-action="Index" class="btn btn-outline-secondary ml-1">Temizle</a></div></form><div class="mt-2"><a asp-action="Index" class="btn btn-sm @(filter==null?"btn-primary":"btn-outline-primary")">Tümü</a><a asp-action="Active" class="btn btn-sm @(filter=="Active"?"btn-success":"btn-outline-success")">Aktif</a><a asp-action="Inactive" class="btn btn-sm @(filter=="Inactive"?"btn-secondary":"btn-outline-secondary")">Pasif</a></div></div></div>
<div class="wh-tile"><div class="wh-tile-header"><i class="fas fa-list"></i> Ambar Listesi</div><div class="wh-tile-body"><div class="table-responsive"><table class="table table-hover"><thead class="thead-light"><tr><th>Kod</th><th>Ambar Adı</th><th>Bağlı Organizasyon</th><th>Stok</th><th>Durum</th><th>İşlemler</th></tr></thead><tbody>
@foreach(var x in rows){<tr><td><span class="badge badge-light border p-2">@x.Code</span></td><td class="font-weight-bold">@x.Name</td><td>@(x.UnitName??"Ortak / Belirtilmemiş")</td><td>@x.WarehouseStockCount</td><td>@if(x.IsActive){<span class="badge badge-success p-2">Aktif</span>}else{<span class="badge badge-secondary p-2">Pasif</span>}</td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-info" title="Detay"><i class="fas fa-eye"></i></a> <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary" title="Düzenle"><i class="fas fa-edit"></i></a> <a asp-action="Stocks" asp-route-id="@x.Id" class="btn btn-sm btn-outline-secondary" title="Stok"><i class="fas fa-boxes"></i></a> <form asp-action="ChangeStatus" asp-area="Admin" asp-controller="Warehouse" method="post" class="d-inline" onsubmit="return confirm('Ambar durumu değiştirilsin mi?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id" /><input type="hidden" name="isActive" value="@(!x.IsActive?"true":"false")" /><button type="submit" title="Durum değiştir" class="btn btn-sm @(x.IsActive?"btn-outline-danger":"btn-outline-success")"><i class="fas @(x.IsActive?"fa-ban":"fa-check")"></i></button></form></td></tr>}
@if(rows.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">Listelenecek ambar bulunamadı.</td></tr>}</tbody></table></div></div></div></div>
