@model MaintenanceManagement.Application.DTOS.WarehouseDtos.GetByIdWarehouseDto
@{
    ViewData["Title"] = "Ambar Detayı";
    var assigned = (ViewBag.AssignedPersonnelIds as IEnumerable<int> ?? Enumerable.Empty<int>()).ToList();
    var personnelNames = ViewBag.AssignedPersonnelNames as Dictionary<int,string> ?? new Dictionary<int,string>();
}
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
@section Styles { <link rel="stylesheet" href="~/css/warehouse-wizard.css" asp-append-version="true" /> }
<div class="container-fluid wh-page"><div class="wh-header d-flex flex-wrap justify-content-between align-items-center"><div><h1 class="wh-title"><i class="fas fa-warehouse text-primary mr-2"></i>@Model.Name</h1><p class="wh-subtitle">Ambar kodu: @Model.Code · Organizasyon: @(Model.UnitName??"—")</p></div><div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn wh-btn-primary"><i class="fas fa-edit mr-1"></i>Düzenle</a> <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a></div></div>
@if(TempData["SuccessMessage"] != null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}
<div class="row"><div class="col-lg-8"><div class="wh-tile"><div class="wh-tile-header"><i class="fas fa-info-circle"></i>Ambar Bilgileri</div><div class="wh-tile-body"><div class="wh-overview-item"><span>Ambar Kodu</span><strong>@Model.Code <i class="fas fa-lock text-muted ml-1"></i></strong></div><div class="wh-overview-item"><span>Ambar Adı</span><strong>@Model.Name</strong></div><div class="wh-overview-item"><span>Organizasyon</span><strong>@(Model.UnitName??"—")</strong></div><div class="wh-overview-item"><span>Konum</span><strong>@(Model.Location??"—")</strong></div><div class="wh-overview-item"><span>Açıklama</span><strong>@(Model.Description??"—")</strong></div><div class="wh-overview-item"><span>Durum</span><strong>@Model.IsActiveName</strong></div><div class="wh-overview-item"><span>Oluşturulma</span><strong>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</strong></div></div></div><div class="wh-tile"><div class="wh-tile-header"><i class="fas fa-user-shield"></i>Yetkili Personel</div><div class="wh-tile-body"><p class="wh-muted mb-2">Toplam @assigned.Count yetkili personel</p>@foreach(var id in assigned){<span class="badge badge-light border mr-2 mb-2 p-2">@(personnelNames.TryGetValue(id, out var fullInfo) ? fullInfo : "Personel kaydı bulunamadı")</span>}@if(!assigned.Any()){<p class="text-muted">Henüz personel kaydı bulunmuyor.</p>}</div></div></div><aside class="col-lg-4"><div class="wh-aside"><div class="wh-aside-icon"><i class="fas fa-boxes"></i></div><h5 class="text-center font-weight-bold">Ambar Özeti</h5><div class="wh-overview-item"><span>Stok Kayıtları</span><strong>@Model.WarehouseStockCount</strong></div><div class="wh-overview-item"><span>Mevcut Malzeme</span><strong>@Model.AvailableMaterialCount</strong></div><div class="wh-overview-item"><span>Stok Hareketleri</span><strong>@Model.StockMovementCount</strong></div><div class="wh-overview-item"><span>Görevli Personel</span><strong>@assigned.Count</strong></div><a asp-action="Stocks" asp-route-id="@Model.Id" class="btn btn-block btn-outline-primary mt-3">Stokları Gör</a><a asp-action="Materials" asp-route-id="@Model.Id" class="btn btn-block btn-outline-primary">Malzemeleri Gör</a><a asp-action="Movements" asp-route-id="@Model.Id" class="btn btn-block btn-outline-secondary">Hareketleri Gör</a></div></aside></div></div>