@model MaintenanceManagement.WebUI.Areas.Admin.Models.OrganizationTreeSelectorVm

@using System.Linq

@{
    var organizations = Model.Organizations
        ?? new List<MaintenanceManagement.WebUI.Areas.Admin.Models.OrganizationTreeNodeVm>();

    var selectedIds = (Model.SelectedUnitIds ?? new List<int>())
        .ToHashSet();
}

<div class="card border-left-primary shadow-sm mb-4"
     id="materialCategoryOrganizationSelector">

    <div class="card-header py-3">

        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-sitemap mr-2"></i>
            Organizasyon Kullanım Kapsamı
        </h6>

    </div>

    <div class="card-body">

        <div class="alert alert-info small">

            <i class="fas fa-info-circle mr-1"></i>

            Hiçbir organizasyon seçilmezse, bu kategorideki
            malzemeler tüm organizasyonların ambarlarında
            kullanılabilir.

        </div>

        <!-- ARAMA -->
        <div class="input-group mb-3">

            <div class="input-group-prepend">

                <span class="input-group-text">
                    <i class="fas fa-search"></i>
                </span>

            </div>

            <input type="search"
                   class="form-control"
                   id="organizationSearch"
                   placeholder="Organizasyon adı yazarak ara..."
                   autocomplete="off" />

        </div>

        <!-- ORGANİZASYON AĞACI -->
        <div class="border rounded p-3 bg-white"
             style="max-height:350px;overflow-y:auto;">

            @if (!organizations.Any())
            {
                <div class="text-center text-muted py-3">
                    Aktif organizasyon bulunamadı.
                </div>
            }
            else
            {
                <ul id="organizationTree"
                    class="list-unstyled mb-0">
                </ul>

                <!-- AĞAÇ OLUŞTURMA VERİLERİ -->
                <div id="organizationTreeSource"
                     class="d-none">

                    @foreach (var organization in organizations)
                    {
                        <div class="organization-source-item"
                             data-id="@organization.Id"
                             data-parent="@organization.ParentUnitId"
                             data-name="@organization.Name"
                             data-selected="@selectedIds.Contains(organization.Id).ToString().ToLowerInvariant()">
                        </div>
                    }

                </div>
            }

        </div>

        <!-- SEÇİM DURUMU -->
        <div class="d-flex justify-content-between
            align-items-center flex-wrap mt-3">

            <span id="organizationSelectionStatus"
                  class="badge badge-success p-2">

                Tüm Organizasyonlara Açık

            </span>

            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    id="clearOrganizationSelection">

                <i class="fas fa-eraser mr-1"></i>
                Seçimleri Temizle

            </button>

        </div>

        <div id="selectedOrganizationBadges"
             class="mt-3">
        </div>

        <!-- MVC MODEL BINDING ALANI -->
        <div id="selectedOrganizationInputs">
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const source = document.getElementById(
            "organizationTreeSource"
        );

        const tree = document.getElementById(
            "organizationTree"
        );

        if (!source || !tree) {
            return;
        }

        const searchInput = document.getElementById(
            "organizationSearch"
        );

        const status = document.getElementById(
            "organizationSelectionStatus"
        );

        const clearButton = document.getElementById(
            "clearOrganizationSelection"
        );

        const selectedBadges = document.getElementById(
            "selectedOrganizationBadges"
        );

        const selectedInputs = document.getElementById(
            "selectedOrganizationInputs"
        );

        // =====================================
        // 1. ORGANİZASYON VERİLERİ
        // =====================================

        const organizations = Array.from(
            source.querySelectorAll(".organization-source-item")
        ).map(item => ({
            id: item.dataset.id,
            parentId: item.dataset.parent || null,
            name: item.dataset.name,
            selected: item.dataset.selected === "true",
            children: []
        }));

        const map = new Map();

        organizations.forEach(item => {
            map.set(item.id, item);
        });

        const roots = [];

        // =====================================
        // 2. AĞAÇ HİYERARŞİSİ
        // =====================================

        organizations.forEach(item => {

            const parent = map.get(item.parentId);

            if (parent && parent !== item) {
                parent.children.push(item);
            }
            else {
                roots.push(item);
            }

        });

        // =====================================
        // 3. AĞAÇ ELEMANI OLUŞTUR
        // =====================================

        function renderNode(node) {

            const li = document.createElement("li");

            li.className = "mb-1 organization-tree-node";

            li.dataset.id = node.id;
            li.dataset.name = node.name;

            const row = document.createElement("div");

            row.className =
                "d-flex align-items-center py-1";

            const toggle = document.createElement("button");

            toggle.type = "button";

            toggle.className =
                "btn btn-link btn-sm text-secondary p-0 mr-2";

            toggle.style.width = "22px";

            const icon = document.createElement("i");

            icon.className = node.children.length
                ? "fas fa-chevron-right"
                : "fas fa-minus text-muted";

            toggle.appendChild(icon);

            const checkbox = document.createElement("input");

            checkbox.type = "checkbox";
            checkbox.className = "mr-2 organization-checkbox";
            checkbox.value = node.id;
            checkbox.checked = node.selected;

            const label = document.createElement("label");

            label.className = "mb-0";
            label.textContent = node.name;

            checkbox.id = "organization_" + node.id;
            label.htmlFor = checkbox.id;

            row.appendChild(toggle);
            row.appendChild(checkbox);
            row.appendChild(label);

            li.appendChild(row);

            const childList = document.createElement("ul");

            childList.className =
                "list-unstyled ml-4 pl-2 border-left d-none";

            node.children.forEach(child => {
                childList.appendChild(renderNode(child));
            });

            li.appendChild(childList);

            if (node.children.length) {

                toggle.setAttribute("aria-expanded", "false");

                toggle.addEventListener("click", function () {

                    const isClosed =
                        childList.classList.contains("d-none");

                    childList.classList.toggle("d-none", !isClosed);

                    icon.className = isClosed
                        ? "fas fa-chevron-down"
                        : "fas fa-chevron-right";

                    toggle.setAttribute(
                        "aria-expanded",
                        String(isClosed)
                    );
                });

            }
            else {
                toggle.disabled = true;
            }

            checkbox.addEventListener(
                "change",
                updateSelection
            );

            return li;
        }

        roots.forEach(node => {
            tree.appendChild(renderNode(node));
        });

        // =====================================
        // 4. SEÇİLEN ORGANİZASYONLAR
        // =====================================

        function updateSelection() {

            const checked = Array.from(
                tree.querySelectorAll(
                    ".organization-checkbox:checked"
                )
            );

            selectedBadges.replaceChildren();
            selectedInputs.replaceChildren();

            checked.forEach(checkbox => {

                const node = checkbox.closest(
                    ".organization-tree-node"
                );

                const name = node.dataset.name;

                // Seçilen organizasyonu göster.
                const badge = document.createElement("span");

                badge.className =
                    "badge badge-light border p-2 mr-2 mb-2";

                badge.textContent = name;

                selectedBadges.appendChild(badge);

                // SelectedUnitIds MVC model binding.
                const hidden = document.createElement("input");

                hidden.type = "hidden";
                hidden.name = "SelectedUnitIds";
                hidden.value = checkbox.value;

                selectedInputs.appendChild(hidden);

            });

            if (checked.length === 0) {

                status.className =
                    "badge badge-success p-2";

                status.textContent =
                    "Tüm Organizasyonlara Açık";

            }
            else {

                status.className =
                    "badge badge-primary p-2";

                status.textContent =
                    checked.length + " Organizasyon Seçili";
            }
        }

        // =====================================
        // 5. ORGANİZASYON ARAMA
        // =====================================

        function normalize(value) {
            return value.toLocaleLowerCase("tr-TR").trim();
        }

        function filterNode(li, query) {

            const name = normalize(li.dataset.name);

            const matches = name.includes(query);

            const childrenList = li.querySelector(
                ":scope > ul"
            );

            const children = Array.from(
                childrenList.children
            );

            let childMatches = false;

            children.forEach(child => {

                if (filterNode(child, query)) {
                    childMatches = true;
                }

            });

            const visible = matches || childMatches;

            li.classList.toggle("d-none", !visible);

            if (query && childMatches) {

                childrenList.classList.remove("d-none");

            }

            return visible;
        }

        searchInput.addEventListener("input", function () {

            const query = normalize(this.value);

            if (!query) {

                tree.querySelectorAll(
                    ".organization-tree-node"
                ).forEach(node => {

                    node.classList.remove("d-none");

                    const children = node.querySelector(
                        ":scope > ul"
                    );

                    children.classList.add("d-none");
                });

                return;
            }

            Array.from(tree.children).forEach(node => {
                filterNode(node, query);
            });

        });

        // =====================================
        // 6. SEÇİMLERİ TEMİZLE
        // =====================================

        clearButton.addEventListener("click", function () {

            tree.querySelectorAll(
                ".organization-checkbox"
            ).forEach(checkbox => {

                checkbox.checked = false;

            });

            updateSelection();

        });

        // =====================================
        // 7. İLK YÜKLEME
        // =====================================

        updateSelection();

    });
</script>
