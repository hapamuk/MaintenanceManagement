@model MaintenanceManagement.Application.DTOS.MaterialCategoryDtos.UpdateMaterialCategoryDto
@using MaintenanceManagement.WebUI.Areas.Admin.Models
@{
    ViewData["Title"] = "Malzeme Kategorisi Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var treeNodes = ViewBag.OrganizationNodes as IReadOnlyList<OrganizationTreeNodeVm> ?? new List<OrganizationTreeNodeVm>();
}
<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div><h1 class="h3 mb-1 text-gray-800">Malzeme Kategorisi Güncelle</h1><p class="text-muted mb-0">Kategori bilgileri ve organizasyon kullanım kapsamı</p></div>
        <a asp-area="Admin" asp-controller="MaterialCategory" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left mr-1"></i> Detaylara Dön</a>
    </div>
    <form asp-area="Admin" asp-controller="MaterialCategory" asp-action="Edit" asp-route-id="@Model.Id" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row">
            <div class="col-lg-5">
                <div class="card shadow-sm mb-4">
                    <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-edit mr-2"></i>Kategori Bilgileri</h6></div>
                    <div class="card-body">
                        <div class="form-group"><label asp-for="Name" class="font-weight-bold"></label><span class="text-danger"> *</span><input asp-for="Name" class="form-control" maxlength="150" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                        <div class="form-group mb-0"><label asp-for="Description" class="font-weight-bold"></label><textarea asp-for="Description" class="form-control" rows="5" maxlength="500"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                @await Html.PartialAsync("_OrganizationTreeSelector", new OrganizationTreeSelectorVm { Organizations = treeNodes, SelectedUnitIds = Model.SelectedUnitIds ?? new List<int>() })
            </div>
        </div>
        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex justify-content-end flex-wrap">
                <a asp-area="Admin" asp-controller="MaterialCategory" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary mr-2">Vazgeç</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Değişiklikleri Kaydet</button>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
