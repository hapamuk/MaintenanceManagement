@model IReadOnlyList<ResultUserDto>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between
        align-items-center mb-4">

        <h3>Kullanıcı Yönetimi</h3>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Register"
           class="btn btn-primary">

            <i class="fas fa-plus"></i>
            Yeni Kullanıcı
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Kullanıcı Listesi
            </h6>
        </div>

        <div class="card-body">

            @if (Model == null || Model.Count == 0)
            {
                <p class="text-muted">
                    Kayıtlı kullanıcı bulunamadı.
                </p>
            }
            else
            {
                @foreach (var user in Model)
                {
                    <div class="card mb-3">
                        <div class="card-body">

                            <div class="row">
                                <div class="col-md-9">
                                    @Html.DisplayFor(m => user)
                                </div>
                            </div>

                            <div class="mt-3">

                                <a asp-action="Details"
                                   asp-route-id="@user.Id"
                                   class="btn btn-info btn-sm">
                                    Detay
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@user.Id"
                                   class="btn btn-warning btn-sm">
                                    Güncelle
                                </a>

                                <form asp-action="ChangeStatus"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    <input type="hidden"
                                           name="isActive"
                                           value="@(user.IsActive ? "false" : "true")" />

                                    <button type="submit"
                                            class="btn btn-outline-secondary btn-sm"
                                            onclick="return confirm('Durum değiştirilsin mi?');">
                                        @(user.IsActive ? "Pasifleştir" : "Aktifleştir")
                                    </button>
                                </form>

                                <form asp-action="ChangeSystemAccess"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    <input type="hidden"
                                           name="hasSystemAccess"
                                           value="@(user.HasSystemAccess ? "false" : "true")" />

                                    <button type="submit"
                                            class="btn btn-outline-primary btn-sm"
                                            onclick="return confirm('Sistem erişimi değiştirilsin mi?');">
                                        @(user.HasSystemAccess ? "Erişimi Kapat" : "Erişim Ver")
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
