
@model MaintenanceManagement.Application.DTOS.UserDtos.LoginUserDto

@{
    ViewData["Title"] = "Sisteme Giriş";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />

    <meta http-equiv="X-UA-Compatible"
          content="IE=edge" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <meta name="description"
          content="Demirbaş ve Bakım Yönetim Sistemi" />

    <title>Demirbaş ve Bakım Yönetim Sistemi - Giriş</title>

    <!-- Font Awesome -->
    <link href="~/tema/vendor/fontawesome-free/css/all.min.css"
          rel="stylesheet"
          type="text/css" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito:300,400,600,700,800,900"
          rel="stylesheet" />

    <!-- SB Admin 2 CSS -->
    <link href="~/tema/css/sb-admin-2.min.css"
          rel="stylesheet" />

    <style>
        /* =====================================
           1. GENEL SAYFA TASARIMI
           ===================================== */

        * {
            box-sizing: border-box;
        }

        body.login-page {
            margin: 0;
            min-height: 100vh;
            font-family: 'Nunito', sans-serif;

            background:
                radial-gradient(
                    circle at 8% 6%,
                    rgba(112, 181, 255, .85),
                    transparent 42%
                ),
                linear-gradient(
                    135deg,
                    #4288f5 0%,
                    #2860dc 55%,
                    #1743b4 100%
                );
        }

        .login-wrapper {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 36px 24px;
        }

        /* =====================================
           2. ANA GİRİŞ KARTI
           ===================================== */

        .login-card {
            width: 100%;
            max-width: 1236px;
            min-height: 770px;

            display: flex;
            overflow: hidden;

            background: #ffffff;
            border: 0;
            border-radius: 18px;

            box-shadow:
                0 28px 65px rgba(11, 39, 110, .22);
        }

        /* =====================================
           3. SOL GÖRSEL PANELİ
           ===================================== */

        .login-left {
            flex: 0 0 53.5%;
            position: relative;

            background-color: #e6f0ff;
            background-image:
                url('@Url.Content("~/tema/img/login_sol_panel.png")');

            background-position: center center;
            background-size: 100% 100%;
            background-repeat: no-repeat;
        }

        /* =====================================
           4. SAĞ FORM PANELİ
           ===================================== */

        .login-right {
            flex: 1;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #ffffff;
            padding: 50px 55px;
        }

        .login-form-content {
            width: 100%;
            max-width: 470px;
        }

        /* =====================================
           5. LOGO VE BAŞLIK
           ===================================== */

        .login-logo {
            text-align: center;
            margin-bottom: 24px;

            color: #2864f0;
            font-size: 55px;
            line-height: 1;
        }

        .login-title {
            color: #102852;

            text-align: center;
            font-weight: 900;
            font-size: 31px;
            line-height: 1.24;

            margin-bottom: 15px;
        }

        .login-subtitle {
            text-align: center;
            color: #8290ad;

            font-size: 19px;
            font-weight: 600;

            margin-bottom: 47px;
        }

        /* =====================================
           6. GİRİŞ ALANLARI
           ===================================== */

        .login-field {
            margin-bottom: 25px;
        }

        .login-input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .login-input-icon {
            position: absolute;

            left: 22px;
            top: 50%;
            transform: translateY(-50%);

            color: #64789f;
            font-size: 19px;

            z-index: 2;
            pointer-events: none;
        }

        .login-input {
            width: 100%;
            height: 64px;

            background: #fbfcff;
            border: 1.5px solid #cbd7ef;

            border-radius: 13px;

            padding: 0 18px 0 64px;

            font-size: 15px;
            font-weight: 600;

            color: #19345f;

            transition:
                border-color .2s ease,
                box-shadow .2s ease;
        }

        .login-input::placeholder {
            color: #7e8ca8;
            opacity: 1;
        }

        .login-input:focus {
            outline: none;

            border-color: #326ef1;

            box-shadow:
                0 0 0 4px rgba(50, 110, 241, .10);
        }

        /* =====================================
           7. VALIDATION
           ===================================== */

        .login-validation-summary {
            color: #d9364d;
            font-size: 13px;
            margin-bottom: 16px;
        }

        .login-validation-summary ul {
            margin-bottom: 0;
            padding-left: 18px;
        }

        .field-validation-error {
            display: block;
            color: #e33a50;

            font-size: 12px;
            margin-top: 7px;
        }

        .input-validation-error {
            border-color: #e33a50 !important;
        }

        /* =====================================
           8. GİRİŞ BUTONU
           ===================================== */

        .login-button {
            display: block;

            width: 100%;
            height: 65px;

            border: none;
            border-radius: 16px;

            background:
                linear-gradient(
                    180deg,
                    #367aff 0%,
                    #1450d7 100%
                );

            box-shadow:
                0 9px 22px rgba(35, 91, 221, .15);

            color: #ffffff;

            font-size: 19px;
            font-weight: 800;

            cursor: pointer;

            margin-top: 35px;

            transition:
                transform .2s ease,
                box-shadow .2s ease;
        }

        .login-button:hover {
            color: #ffffff;
            transform: translateY(-2px);

            box-shadow:
                0 13px 28px rgba(35, 91, 221, .23);
        }

        .login-button:focus-visible {
            outline: 3px solid #93b7ff;
            outline-offset: 3px;
        }

        .login-button i {
            margin-right: 10px;
        }

        /* =====================================
           9. ŞİFREMİ UNUTTUM
           ===================================== */

        .login-divider {
            border: 0;
            border-top: 1px solid #dbe3f2;

            margin-top: 42px;
            margin-bottom: 30px;
        }

        .forgot-password {
            display: block;

            text-align: center;
            text-decoration: none;

            color: #205fe9;

            font-size: 16px;
            font-weight: 700;
        }

        .forgot-password i {
            margin-right: 7px;
        }

        .forgot-password:hover {
            color: #0d43b7;
            text-decoration: none;
        }

        /* =====================================
           10. RESPONSIVE TASARIM
           ===================================== */

        @@media (max-width: 991.98px) {

            .login-card {
                max-width: 600px;
                min-height: auto;
            }

            .login-left {
                display: none;
            }

            .login-right {
                padding: 65px 45px;
            }

        }

        @@media (max-width: 575.98px) {

            .login-wrapper {
                padding: 18px 12px;
            }

            .login-card {
                border-radius: 14px;
            }

            .login-right {
                padding: 45px 24px;
            }

            .login-title {
                font-size: 25px;
            }

            .login-subtitle {
                font-size: 16px;
                margin-bottom: 32px;
            }

            .login-input {
                height: 58px;
                font-size: 14px;
            }

            .login-button {
                height: 60px;
                font-size: 17px;
            }

        }

        /* =====================================
           11. KÜÇÜK EKRAN YÜKSEKLİĞİ
           ===================================== */

        @@media (min-width: 992px) and (max-height: 820px) {

            .login-wrapper {
                align-items: flex-start;
            }

            .login-card {
                min-height: 700px;
            }

            .login-right {
                padding-top: 30px;
                padding-bottom: 30px;
            }

            .login-subtitle {
                margin-bottom: 30px;
            }

        }

    </style>

</head>

<body class="login-page">

    <!-- =====================================
         LOGIN WRAPPER
         ===================================== -->

    <div class="login-wrapper">

        <div class="login-card">

            <!-- =====================================
                 SOL TASARIM PANELİ
                 ===================================== -->

            <div class="login-left"
                 role="img"
                 aria-label="Demirbaş takibi, bakım yönetimi ve yetki yönetimi tanıtım görseli">

                <!--
                    Görsel:
                    wwwroot/tema/img/login_sol_panel.png

                    Başlık, illüstrasyon ve ikonlar
                    bu görselin içerisinde bulunmaktadır.
                -->

            </div>

            <!-- =====================================
                 SAĞ LOGIN PANELİ
                 ===================================== -->

            <div class="login-right">

                <div class="login-form-content">

                    <!-- =====================================
                         LOGO
                         ===================================== -->

                    <div class="login-logo">

                        <i class="fas fa-layer-group"></i>

                    </div>

                    <!-- =====================================
                         BAŞLIK
                         ===================================== -->

                    <h1 class="login-title">

                        Demirbaş ve Bakım
                        <br />
                        Yönetim Sistemi

                    </h1>

                    <p class="login-subtitle">
                        Kurumsal Kullanıcı Girişi
                    </p>

                    <!-- =====================================
                         BAŞARI MESAJI
                         ===================================== -->

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success"
                             role="alert">

                            <i class="fas fa-check-circle mr-1"></i>

                            @TempData["Success"]

                        </div>
                    }

                    <!-- =====================================
                         HATA MESAJI
                         ===================================== -->

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger"
                             role="alert">

                            <i class="fas fa-exclamation-circle mr-1"></i>

                            @TempData["Error"]

                        </div>
                    }

                    <!-- =====================================
                         LOGIN FORM
                         ===================================== -->

                    <form asp-area="Admin"
                          asp-controller="User"
                          asp-action="Login"
                          asp-route-returnUrl="@ViewBag.ReturnUrl"
                          method="post"
                          autocomplete="on">

                        @Html.AntiForgeryToken()

                        <!-- Model Validation -->
                        <div asp-validation-summary="ModelOnly"
                             class="login-validation-summary">
                        </div>

                        <!-- =====================================
                             KULLANICI ADI / E-POSTA
                             ===================================== -->

                        <div class="login-field">

                            <div class="login-input-wrapper">

                                <i class="far fa-user login-input-icon"></i>

                                <input asp-for="UsernameOrEmail"
                                       type="text"
                                       class="login-input"
                                       placeholder="Kullanıcı Adı veya E-Posta Adresi"
                                       autocomplete="username"
                                       aria-label="Kullanıcı Adı veya E-Posta Adresi" />

                            </div>

                            <span asp-validation-for="UsernameOrEmail"
                                  class="field-validation-error">
                            </span>

                        </div>

                        <!-- =====================================
                             ŞİFRE
                             ===================================== -->

                        <div class="login-field">

                            <div class="login-input-wrapper">

                                <i class="fas fa-lock login-input-icon"></i>

                                <input asp-for="Password"
                                       type="password"
                                       class="login-input"
                                       placeholder="Şifre"
                                       autocomplete="current-password"
                                       aria-label="Şifre" />

                            </div>

                            <span asp-validation-for="Password"
                                  class="field-validation-error">
                            </span>

                        </div>

                        <!-- =====================================
                             GİRİŞ YAP
                             ===================================== -->

                        <button type="submit"
                                class="login-button">

                            <i class="fas fa-sign-in-alt"></i>

                            Giriş Yap

                        </button>

                    </form>

                    <!-- =====================================
                         AYIRICI
                         ===================================== -->

                    <hr class="login-divider" />

                    <!-- =====================================
                         ŞİFREMİ UNUTTUM
                         ===================================== -->

                    <a class="forgot-password"
                       asp-area="Admin"
                       asp-controller="User"
                       asp-action="ForgotPassword">

                        <i class="fas fa-key"></i>

                        Şifremi Unuttum

                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- =====================================
         JAVASCRIPT
         ===================================== -->

    <!-- jQuery -->
    <script src="~/tema/vendor/jquery/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/tema/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- jQuery Easing -->
    <script src="~/tema/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- SB Admin 2 -->
    <script src="~/tema/js/sb-admin-2.min.js"></script>

    <!-- jQuery Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <!-- Unobtrusive Validation -->
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>

</html>
