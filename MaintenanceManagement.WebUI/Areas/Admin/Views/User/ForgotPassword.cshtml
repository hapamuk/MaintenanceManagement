@model ForgotPasswordUserDto

@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="card shadow mb-4">

        <div class="card-header">
            <strong>Şifremi Unuttum</strong>
        </div>

        <div class="card-body">

            <p>
                Kurumsal hesap bilgilerinizle şifre
                sıfırlama talebi oluşturabilirsiniz.
            </p>

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info">
                    @TempData["Info"]
                </div>
            }

            <form asp-action="ForgotPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger"></div>

                @Html.EditorForModel()

                <button type="submit"
                        class="btn btn-primary">
                    Şifre Sıfırlama Talebi Gönder
                </button>

                <a asp-action="Login"
                   class="btn btn-secondary">
                    Girişe Dön
                </a>

            </form>
        </div>
    </div>
</div>
