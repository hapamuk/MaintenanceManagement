@model MaintenanceManagement.WebUI.Areas.Admin.Controllers.AssetKindSetupVm
@{
 Layout="~/Views/Shared/_AdminLayout.cshtml";
 ViewData["Title"]="Demirbaş Türü Tanıtımı";
}
<div class="container-fluid">
 <div class="d-flex justify-content-between align-items-center my-3"><h2 class="h4 text-primary font-weight-bold"><i class="fas fa-layer-group mr-2"></i>Demirbaş Türü Tanıtımı</h2>
 <a class="btn btn-outline-primary" asp-controller="AssetWizard" asp-action="Create">Demirbaş Tanıtımına Git</a></div>
 @if(TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>}
 @if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
 <div class="row"><div class="col-lg-5"><div class="card shadow-sm mb-4"><div class="card-body">
 <form asp-action="Save" method="post">@Html.AntiForgeryToken()
 <input type="hidden" asp-for="Id" />
 <div class="form-group"><label>Kategori *</label><select asp-for="CategoryId" class="form-control" required><option value="0">Kategori seçiniz...</option>@foreach(var x in Model.Categories){<option value="@x.Id">@x.Name</option>}</select></div>
 <div class="form-group"><label>Demirbaş Türü *</label><input asp-for="Name" class="form-control" maxlength="150" required placeholder="Örn. Masaüstü Bilgisayar" /></div>
 <div class="form-group"><label>Bu türe bağlı markalar *</label>
 <input class="form-control mb-2" id="kindBrandSearch" type="search" placeholder="Marka ara..." />
 <div id="kindBrandList" style="max-height:210px;overflow:auto;border:1px solid #dbe4f3;border-radius:10px;padding:12px">
 @foreach(var b in Model.Brands){<label class="d-block kind-brand-option"><input type="checkbox" name="BrandIds" value="@b.Id" @(Model.BrandIds.Contains(b.Id)?"checked":null) /> @b.Name</label>}
 </div><small class="text-muted">Bir marka birden fazla demirbaş türüne bağlanabilir.</small></div>
 <div class="form-group"><label><input asp-for="IsActive" /> Aktif</label></div>
 <button class="btn btn-primary btn-block" type="submit">@(Model.Id>0?"Türü Güncelle":"Türü Kaydet")</button></form>
 </div></div></div><div class="col-lg-7"><div class="card shadow-sm"><div class="card-body"><h5>Kayıtlı türler</h5>
 <table class="table table-hover table-sm"><thead><tr><th>Tür</th><th>Kategori</th><th>Durum</th><th></th></tr></thead><tbody>
 @foreach(var t in Model.Kinds){<tr><td>@t.Name</td><td>@t.Category</td><td>@(t.IsActive?"Aktif":"Pasif")</td><td><a asp-action="Index" asp-route-editId="@t.Id" class="btn btn-outline-primary btn-sm">Düzenle</a></td></tr>}
 </tbody></table></div></div></div></div>
</div>
@section Scripts {<script>
document.getElementById('kindBrandSearch').addEventListener('input',function(){const q=this.value.toLocaleLowerCase('tr-TR');document.querySelectorAll('.kind-brand-option').forEach(x=>x.hidden=!x.textContent.toLocaleLowerCase('tr-TR').includes(q));});
</script>}
