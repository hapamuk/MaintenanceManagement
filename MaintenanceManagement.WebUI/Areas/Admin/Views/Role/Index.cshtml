@model IReadOnlyList<ResultRoleDto>

@{
    ViewData["Title"] = "Rol Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between
        align-items-center mb-4">

        <h3 class="mb-0">Rol Yönetimi</h3>

        <a asp-area="Admin"
           asp-controller="Role"
           asp-action="Create"
           class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Yeni Rol
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Rol Listesi
            </h6>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered
                    table-hover"
                       width="100%">

                    <thead class="thead-light">
                        <tr>
                            <th>Rol Kodu</th>
                            <th>Rol Adı</th>
                           
                         
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model == null || Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center">
                                    Kayıtlı rol bulunamadı.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var role in Model)
                            {
                                <tr>
                                    <td>@role.Id</td>
                                    <td>@role.Name</td>
                                    

                                    <td>
                                        @if (role.IsActive)
                                        {
                                            <span class="badge badge-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">
                                                Pasif
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-area="Admin"
                                           asp-controller="Role"
                                           asp-action="Details"
                                           asp-route-id="@role.Id"
                                           class="btn btn-info btn-sm">
                                            Detay
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="Role"
                                           asp-action="Edit"
                                           asp-route-id="@role.Id"
                                           class="btn btn-warning btn-sm">
                                            Güncelle
                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="Role"
                                              asp-action="ChangeStatus"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@role.Id" />

                                            <input type="hidden"
                                                   name="isActive"
                                                   value="@(role.IsActive ? "false" : "true")" />

                                            @if (role.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-danger btn-sm"
                                                        onclick="return confirm('Rol pasifleştirilsin mi?');">
                                                    Pasifleştir
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-success btn-sm"
                                                        onclick="return confirm('Rol aktifleştirilsin mi?');">
                                                    Aktifleştir
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
