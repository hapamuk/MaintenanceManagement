@model UpdateRoleDto

@{
    ViewData["Title"] = "Rol Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="card shadow mb-4">

        <div class="card-header py-3">

            <h6 class="m-0 font-weight-bold text-primary">
                Rol Güncelle
            </h6>

        </div>

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Role"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post"
                  autocomplete="off">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <input type="hidden"
                       asp-for="UnitId" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="form-group mb-3">

                    <label asp-for="Name">
                        Rol Adı
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group mb-3">

                    <label asp-for="Code">
                        Rol Kodu
                    </label>

                    <input asp-for="Code"
                           class="form-control" />

                    <span asp-validation-for="Code"
                          class="text-danger">
                    </span>
                </div> 

               <div class="form-group mb-3">

                    <label asp-for="UnitId">
                        Bağlı Birim
                    </label>

                    <select asp-for="UnitId"
                            asp-items="ViewBag.UnitOptions"
                            class="form-control"
                            disabled>

                        <option value="0">
                            Birim Seçiniz
                        </option>

                    </select>

                    <small class="form-text text-muted">
                        Rolün bağlı olduğu birim
                        güncelleme sırasında değiştirilemez.
                    </small>
                </div>
 
                <div class="form-group mb-3">

                    <label asp-for="Description">
                        Açıklama
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Güncelle
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Role"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Listeye Dön
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
