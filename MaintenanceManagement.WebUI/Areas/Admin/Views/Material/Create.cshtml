@model MaintenanceManagement.Application.DTOS.MaterialDtos.CreateMaterialDto

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Yeni Malzeme";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var measurementUnits =
        ViewBag.MeasurementUnits as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();

    var categories =
        ViewBag.MaterialCategories as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();
}

<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">
                Yeni Malzeme Tanıtımı
            </h1>
            <p class="text-muted mb-0">
                Sistemde kullanılacak yeni malzemenin bilgilerini giriniz
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Material"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left mr-1"></i>
            Listeye Dön
        </a>
    </div>

    <form asp-area="Admin"
          asp-controller="Material"
          asp-action="Create"
          method="post"
          autocomplete="off">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-xl-8 col-lg-9">

                <div class="card shadow-sm mb-4">

                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="fas fa-box mr-2"></i>
                            Malzeme Bilgileri
                        </h6>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            <div class="form-group">
                                <label asp-for="MaterialCode"
                                       class="font-weight-bold"></label>

                                <input asp-for="MaterialCode"
                                       class="form-control bg-light font-weight-bold"
                                       maxlength="6"
                                       minlength="6"
                                       readonly
                                       autocomplete="off" />

                                <span asp-validation-for="MaterialCode"
                                      class="text-danger small"></span>

                                <small class="form-text text-muted">
                                    Malzeme kodu sistem tarafından otomatik oluşturulur.
                                    Değiştirilemez.
                                </small>
                            </div>

                            <div class="col-md-7">
                                <div class="form-group">
                                    <label asp-for="Name"
                                           class="font-weight-bold"></label>
                                    <span class="text-danger">*</span>

                                    <input asp-for="Name"
                                           class="form-control"
                                           maxlength="200"
                                           placeholder="Malzeme adı" />

                                    <span asp-validation-for="Name"
                                          class="text-danger small"></span>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="MeasurementUnitId"
                                           class="font-weight-bold"></label>
                                    <span class="text-danger">*</span>

                                    <select asp-for="MeasurementUnitId"
                                            asp-items="measurementUnits"
                                            class="form-control">
                                        <option value="">Ölçü birimi seçiniz</option>
                                    </select>

                                    <span asp-validation-for="MeasurementUnitId"
                                          class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="MaterialCategoryId"
                                           class="font-weight-bold"></label>

                                    <select asp-for="MaterialCategoryId"
                                            asp-items="categories"
                                            class="form-control">
                                        <option value="">Kategori seçiniz (isteğe bağlı)</option>
                                    </select>

                                    <span asp-validation-for="MaterialCategoryId"
                                          class="text-danger small"></span>
                                </div>
                            </div>

                        </div>

                        <div class="form-group">
                            <label asp-for="MinimumStockLevel"
                                   class="font-weight-bold"></label>

                            <input asp-for="MinimumStockLevel"
                                   type="number"
                                   min="0"
                                   max="999999999.999"
                                   step="0.001"
                                   class="form-control"
                                   style="max-width:300px;" />

                            <span asp-validation-for="MinimumStockLevel"
                                  class="text-danger small"></span>

                            <small class="form-text text-muted">
                                Malzemenin kritik stok seviyesi.
                            </small>
                        </div>

                        <div class="form-group mb-0">
                            <label asp-for="Description"
                                   class="font-weight-bold"></label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Malzemeyle ilgili açıklama..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small"></span>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-lg-3">
                <div class="card border-left-info shadow-sm mb-4">
                    <div class="card-body">
                        <h6 class="font-weight-bold text-info">
                            <i class="fas fa-info-circle mr-1"></i>
                            Organizasyon Kapsamı
                        </h6>

                        <p class="small text-muted mb-0">
                            Malzemeye doğrudan organizasyon atanmaz.
                            Organizasyon erişim kapsamı,
                            Malzeme Kategori Yönetimi ekranında
                            tanımlanır.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body text-right">

                <a asp-action="Index"
                   class="btn btn-outline-secondary mr-2">
                    Vazgeç
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save mr-1"></i>
                    Malzemeyi Kaydet
                </button>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
