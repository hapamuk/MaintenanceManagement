@model IReadOnlyList<MaintenanceManagement.Application.DTOS.MaterialDtos.ResultMaterialDto>

@using System.Linq

@{
    ViewData["Title"] = "Malzeme Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string searchText = ViewBag.SearchText as string
        ?? string.Empty;

    bool onlyActive = ViewBag.OnlyActive == true;
}

<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">
                Malzeme Yönetimi
            </h1>
            <p class="text-muted mb-0">
                Malzeme tanımları, ölçü birimleri ve stok seviyeleri
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Material"
           asp-action="Create"
           class="btn btn-primary btn-sm shadow-sm">
            <i class="fas fa-plus mr-1"></i>
            Yeni Malzeme
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    <!-- FİLTRELER -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Material"
                  asp-action="Search"
                  method="get">

                <div class="row align-items-end">

                    <div class="col-lg-7 col-md-6 form-group">
                        <label class="small font-weight-bold">
                            Malzeme Ara
                        </label>
                        <input type="text"
                               name="searchText"
                               value="@searchText"
                               class="form-control"
                               placeholder="Malzeme kodu veya adı..." />
                    </div>

                    <div class="col-lg-2 col-md-3 form-group">
                        <div class="custom-control custom-checkbox mb-2">
                            <input type="checkbox"
                                   class="custom-control-input"
                                   id="onlyActive"
                                   name="onlyActive"
                                   value="true"
                                   checked="@onlyActive" />
                            <label class="custom-control-label"
                                   for="onlyActive">
                                Yalnızca aktif
                            </label>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-3 form-group text-md-right">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search mr-1"></i>Ara
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Temizle
                        </a>
                    </div>

                </div>
            </form>

            <div class="btn-group btn-group-sm">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">Tümü</a>

                <a asp-action="Active"
                   class="btn btn-outline-success">Aktifler</a>

                <a asp-action="Inactive"
                   class="btn btn-outline-danger">Pasifler</a>
            </div>

        </div>
    </div>

    <!-- MALZEME TABLOSU -->
    <div class="card shadow-sm mb-4">

        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-boxes mr-2"></i>Malzeme Listesi
            </h6>

            <span class="badge badge-primary">
                @(Model?.Count ?? 0) kayıt
            </span>
        </div>

        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-bordered table-hover"
                       width="100%">
                    <thead class="thead-light">
                        <tr>
                            <th>Malzeme Kodu</th>
                            <th>Malzeme Adı</th>
                            <th>Ölçü Birimi</th>
                            <th>Kategori</th>
                            <th>Minimum Stok</th>
                            <th>Durum</th>
                            <th style="min-width:180px;">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.MaterialCode</strong>
                                    </td>

                                    <td>@item.Name</td>

                                    <td>
                                        @item.MeasurementUnitName
                                        @if (!string.IsNullOrWhiteSpace(item.MeasurementUnitSymbol))
                                        {
                                            <small class="text-muted">
                                                (@item.MeasurementUnitSymbol)
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        @(item.MaterialCategoryName ?? "Belirtilmedi")
                                    </td>

                                    <td>
                                        @item.MinimumStockLevel.ToString("N2")
                                    </td>

                                    <td>
                                        <span class="badge @(item.IsActive ? "badge-success" : "badge-secondary") p-2">
                                            @item.IsActiveName
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap" style="gap:5px;">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-info btn-sm"
                                               title="Detay">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-primary btn-sm"
                                               title="Güncelle">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <a asp-action="WarehouseStocks"
                                               asp-route-id="@item.Id"
                                               class="btn btn-secondary btn-sm"
                                               title="Ambar Stokları">
                                                <i class="fas fa-warehouse"></i>
                                            </a>

                                            <form asp-action="ChangeStatus"
                                                  method="post"
                                                  class="d-inline material-status-form">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden"
                                                       name="isActive"
                                                       value="@(!item.IsActive)" />

                                                <button type="submit"
                                                        class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                        title="@(item.IsActive ? "Pasifleştir" : "Aktifleştir")">
                                                    <i class="fas @(item.IsActive ? "fa-ban" : "fa-check")"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="fas fa-box-open mr-1"></i>
                                    Malzeme kaydı bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".material-status-form")
            .forEach(function (form) {
                form.addEventListener("submit", function (e) {
                    if (!confirm("Malzemenin durumunu değiştirmek istiyor musunuz?")) {
                        e.preventDefault();
                    }
                });
            });
    </script>
}
