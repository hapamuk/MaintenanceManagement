@model IReadOnlyList<MaintenanceManagement.Application.DTOS.UnitDtos.ResultUnitDto>

@{
    ViewData["Title"] = "Birim Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int rowNumber = 0;
}

<div class="container-fluid">

    <!-- ===================================== -->
    <!-- PAGE HEADING -->
    <!-- ===================================== -->

    <div class="d-sm-flex align-items-center
        justify-content-between mb-4">

        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-sitemap text-primary mr-2"></i>
            Birim Yönetimi
        </h1>

        <a asp-area="Admin"
           asp-controller="Unit"
           asp-action="Create"
           class="btn btn-primary shadow-sm">

            <i class="fas fa-plus fa-sm text-white-50 mr-1"></i>
            Yeni Birim Oluştur
        </a>

    </div>

    <!-- ===================================== -->
    <!-- INFORMATION -->
    <!-- ===================================== -->

    <div class="alert alert-info shadow-sm">

        <i class="fas fa-info-circle mr-2"></i>

        Organizasyon birimlerinin kayıt,
        güncelleme ve aktiflik işlemlerini
        bu ekran üzerinden yönetebilirsiniz.

    </div>

    <!-- ===================================== -->
    <!-- SUCCESS MESSAGE -->
    <!-- ===================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="fas fa-check-circle mr-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="close"
                    data-dismiss="alert">
                <span>&times;</span>
            </button>

        </div>
    }

    <!-- ===================================== -->
    <!-- ERROR MESSAGE -->
    <!-- ===================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="fas fa-exclamation-circle mr-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="close"
                    data-dismiss="alert">
                <span>&times;</span>
            </button>

        </div>
    }

    <!-- ===================================== -->
    <!-- UNIT LIST CARD -->
    <!-- ===================================== -->

    <div class="card shadow mb-4">

        <div class="card-header py-3
            d-flex justify-content-between align-items-center">

            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-list mr-2"></i>
                Organizasyon Birimleri
            </h6>

            <span class="badge badge-primary">
                Toplam: @(Model?.Count ?? 0)
            </span>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover"
                       id="unitTable"
                       width="100%"
                       cellspacing="0">

                    <thead class="bg-light">

                        <tr>
                            <th style="width:60px">#</th>
                            <th>Birim Adı</th>
                            <th>Birim Kodu</th>
                            <th style="width:130px">Durum</th>
                            <th style="width:330px">İşlemler</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                rowNumber++;

                                <tr>

                                    <td>@rowNumber</td>

                                    <td>
                                        <strong>
                                            @item.Name
                                        </strong>
                                    </td>

                                    <td>
                                        <code>@item.Code</code>
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge badge-success p-2">
                                                <i class="fas fa-check-circle mr-1"></i>
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger p-2">
                                                <i class="fas fa-times-circle mr-1"></i>
                                                Pasif
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        <!-- DETAILS -->
                                        <a asp-area="Admin"
                                           asp-controller="Unit"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm">

                                            <i class="fas fa-eye"></i>
                                            Detay
                                        </a>

                                        <!-- EDIT -->
                                        <a asp-area="Admin"
                                           asp-controller="Unit"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">

                                            <i class="fas fa-edit"></i>
                                            Güncelle
                                        </a>

                                        <!-- CHANGE STATUS -->
                                        <form asp-area="Admin"
                                              asp-controller="Unit"
                                              asp-action="ChangeStatus"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <input type="hidden"
                                                   name="isActive"
                                                   value="@(item.IsActive ? "false" : "true")" />

                                            <button type="submit"
                                                    class="btn btn-sm @(item.IsActive ? "btn-danger" : "btn-success")"
                                                    onclick="return confirm('Birim durumu değiştirilsin mi?');">

                                                @if (item.IsActive)
                                                {
                                                    <i class="fas fa-ban"></i>
                                                    <span>Pasifleştir</span>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-check"></i>
                                                    <span>Aktifleştir</span>
                                                }

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">

                                    <i class="fas fa-folder-open fa-2x mb-3"></i>

                                    <p class="mb-0">
                                        Kayıtlı organizasyon birimi bulunamadı.
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
