@model MaintenanceManagement.Application.DTOS.UnitDtos.UpdateUnitDto

@{
    ViewData["Title"] = "Birim Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- ===================================== -->
    <!-- PAGE HEADING -->
    <!-- ===================================== -->

    <div class="d-sm-flex align-items-center
                justify-content-between mb-4">

        <h1 class="h3 mb-0 text-gray-800">

            <i class="fas fa-edit text-primary mr-2"></i>
            Organizasyon Birimi Güncelle

        </h1>

        <a asp-area="Admin"
           asp-controller="Unit"
           asp-action="Index"
           class="btn btn-secondary shadow-sm">

            <i class="fas fa-arrow-left mr-1"></i>
            Listeye Dön

        </a>

    </div>

    <!-- ===================================== -->
    <!-- EDIT CARD -->
    <!-- ===================================== -->

    <div class="card shadow mb-4">

        <div class="card-header py-3">

            <h6 class="m-0 font-weight-bold text-primary">

                <i class="fas fa-building mr-2"></i>
                Birim Güncelleme Formu

            </h6>

        </div>

        <div class="card-body">

            <!-- ===================================== -->
            <!-- INFORMATION -->
            <!-- ===================================== -->

            <div class="alert alert-warning">

                <i class="fas fa-exclamation-triangle mr-2"></i>

                Organizasyon birimi bilgilerini güncellerken
                mevcut kullanıcı, rol ve iş süreçleriyle
                ilişkilerini dikkate alınız.

            </div>

            <!-- ===================================== -->
            <!-- EDIT FORM -->
            <!-- ===================================== -->

            <form asp-area="Admin"
                  asp-controller="Unit"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post"
                  autocomplete="off">

                @Html.AntiForgeryToken()

                <!-- UNIT ID -->
                <input type="hidden" asp-for="Id" />

                <!-- VALIDATION SUMMARY -->
                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- ===================================== -->
                    <!-- ORGANİZASYON TÜRÜ -->
                    <!-- ===================================== -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="OrganizationTypeEnum"
                                   class="font-weight-bold">

                                Organizasyon Türü

                                <span class="text-danger">*</span>

                            </label>

                            <select asp-for="OrganizationTypeEnum"
                                    asp-items="ViewBag.OrganizationTypes"
                                    class="form-control">

                                <option value="0">
                                    -- Organizasyon Türü Seçiniz --
                                </option>

                            </select>

                            <span asp-validation-for="OrganizationTypeEnum"
                                  class="text-danger small">
                            </span>

                            <small class="form-text text-muted">
                                Birimin organizasyon türünü seçiniz.
                            </small>

                        </div>

                    </div>

                    <!-- ===================================== -->
                    <!-- BİRİM KODU -->
                    <!-- ===================================== -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label asp-for="Code"
                                   class="font-weight-bold">

                                Birim Kodu

                            </label>

                            <div class="input-group">

                                <input asp-for="Code"
                                       class="form-control bg-light"
                                       readonly="readonly"
                                       aria-readonly="true" />

                                <div class="input-group-append">

                                    <span class="input-group-text">

                                        <i class="fas fa-lock text-secondary"></i>

                                    </span>

                                </div>

                            </div>

                            <small class="form-text text-muted">
                                Bu kod sistem tarafından otomatik
                                oluşturulmuştur ve değiştirilemez.
                            </small>

                        </div>

                    </div>

                    <!-- ===================================== -->
                    <!-- BİRİM ADI -->
                    <!-- ===================================== -->

                    <div class="col-md-12">

                        <div class="form-group">

                            <label asp-for="Name"
                                   class="font-weight-bold">

                                Birim Adı

                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Örn: Bilgi İşlem Müdürlüğü" />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                    <!-- ===================================== -->
                    <!-- ÜST BİRİM -->
                    <!-- ===================================== -->

                    <div class="col-md-12">

                        <div class="form-group">

                            <label asp-for="ParentUnitId"
                                   class="font-weight-bold">

                                <i class="fas fa-sitemap text-primary mr-1"></i>

                                Üst Birim

                            </label>

                            <select asp-for="ParentUnitId"
                                    asp-items="ViewBag.ParentUnits"
                                    class="form-control">

                                <option value="">
                                    -- Üst Birim Yok (Ana Birim) --
                                </option>

                            </select>

                            <span asp-validation-for="ParentUnitId"
                                  class="text-danger small">
                            </span>

                            <small class="form-text text-muted">

                                Birimin bağlı olacağı üst organizasyon
                                birimini seçiniz.

                                <br />

                                Üst birim seçilmezse kayıt
                                ana birim olarak güncellenir.

                                <br />

                                Birimin kendisi veya alt birimleri
                                üst birim olarak seçilemez.

                            </small>

                        </div>

                    </div>

                    <!-- ===================================== -->
                    <!-- AÇIKLAMA -->
                    <!-- ===================================== -->

                    <div class="col-md-12">

                        <div class="form-group">

                            <label asp-for="Description"
                                   class="font-weight-bold">

                                Açıklama

                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Birim açıklaması"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>

                <hr />

                <!-- ===================================== -->
                <!-- BUTTONS -->
                <!-- ===================================== -->

                <div class="d-flex justify-content-end">

                    <a asp-area="Admin"
                       asp-controller="Unit"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-secondary mr-2">

                        <i class="fas fa-times mr-1"></i>
                        Vazgeç

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fas fa-save mr-1"></i>
                        Değişiklikleri Kaydet

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
