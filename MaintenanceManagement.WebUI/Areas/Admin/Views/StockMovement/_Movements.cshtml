@model IReadOnlyList<MaintenanceManagement.Application.DTOs.WarehouseOperations.MovementRow>
<div class="table-responsive">
<table class="table table-hover sm-table">
<thead><tr><th>Tarih / Saat</th><th>İşlem</th><th>Kaynak</th><th>Hedef</th><th>Malzeme</th><th>Miktar</th><th>Referans</th><th>Personel</th><th>Açıklama</th></tr></thead>
<tbody>
@foreach(var x in Model)
{
    var isTransfer = x.Reference.StartsWith("TRF-");
    var isWorkOrder = x.Reference.StartsWith("ISE-");
    <tr>
        <td>@x.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
        <td><span class="badge @(x.Direction == "Giriş" ? "badge-success" : "badge-danger")">@(isTransfer ? "Transfer " + x.Direction : isWorkOrder ? "İş Emri Kullanımı" : "Stok " + x.Direction)</span></td>
        <td>@(isTransfer ? (x.Direction == "Çıkış" ? x.Warehouse : x.SourceWarehouse) : (x.Direction == "Çıkış" ? x.Warehouse : "—"))</td>
        <td>@(isTransfer ? (x.Direction == "Giriş" ? x.Warehouse : x.TargetWarehouse) : (x.Direction == "Giriş" ? x.Warehouse : "—"))</td>
        <td>@x.Material</td>
        <td class="font-weight-bold">@(x.Direction == "Giriş" ? "+" : "−")@x.Quantity.ToString("0.####") @x.Unit</td>
        <td><code>@x.Reference</code></td><td>@x.Personnel</td><td>@x.Description</td>
    </tr>
}
@if(Model.Count == 0)
{
    <tr><td colspan="9" class="text-center text-muted py-5">Kayıt bulunamadı.</td></tr>
}
</tbody></table></div>
