@model IReadOnlyList<MaintenanceManagement.Application.DTOs.WarehouseOperations.MovementRow>
<div class="table-responsive"><table class="table table-hover sm-table">
<thead><tr><th>Tarih</th><th>Hareket</th><th>Ambar</th><th>Malzeme</th><th>Miktar</th><th>Referans</th><th>Personel</th><th>Açıklama</th></tr></thead>
<tbody>
@foreach(var x in Model){<tr><td>@x.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
<td><span class="badge @(x.Direction=="Giriş"?"badge-success":"badge-danger")">@x.Direction</span></td>
<td>@x.Warehouse</td><td>@x.Material</td><td class="font-weight-bold">@(x.Direction=="Giriş"?"+":"−")@x.Quantity.ToString("0.####") @x.Unit</td>
<td><code>@x.Reference</code></td><td>@x.Personnel</td><td>@x.Description</td></tr>}
@if(Model.Count==0){<tr><td colspan="8" class="text-center text-muted py-5">Kayıt bulunamadı.</td></tr>}
</tbody></table></div>
