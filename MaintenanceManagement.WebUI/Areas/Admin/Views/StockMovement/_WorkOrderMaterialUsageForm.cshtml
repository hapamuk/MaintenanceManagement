@model MaintenanceManagement.Application.DTOs.WarehouseOperations.WorkOrderMaterialUsageInput
<form asp-area="Admin" asp-controller="StockMovement" asp-action="UseForWorkOrder" method="post" class="p-3 border rounded">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="WorkOrderId" />
    <h6 class="font-weight-bold">İş Emrinde Kullanılan Malzeme</h6>
    <div class="form-group"><label>Kaynak Ambar ID</label><input asp-for="WarehouseId" type="number" min="1" class="form-control" required /></div>
    <div class="form-group"><label>Malzeme ID</label><input asp-for="MaterialId" type="number" min="1" class="form-control" required /></div>
    <div class="form-group"><label>Miktar</label><input asp-for="Quantity" type="number" step="0.0001" min="0.0001" class="form-control" required /></div>
    <div class="form-group"><label>Açıklama</label><textarea asp-for="Description" maxlength="300" class="form-control"></textarea></div>
    <button type="submit" class="btn btn-primary" onclick="return confirm('Malzeme ambardan düşülsün mü?')">Malzemeyi Kullan</button>
</form>
