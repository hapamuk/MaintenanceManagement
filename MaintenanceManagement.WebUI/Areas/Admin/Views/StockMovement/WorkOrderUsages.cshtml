@{ Layout="~/Views/Shared/_AdminLayout.cshtml"; }
@section Styles {<link rel="stylesheet" href="~/css/stock-management.css" asp-append-version="true" />}

@model MaintenanceManagement.Application.DTOs.WarehouseOperations.WarehousePageVm
@{ ViewData["Title"]="İş Emri Malzeme Kullanımları"; }
<div class="container-fluid sm-page">
<div class="sm-heading"><div class="sm-heading-icon"><i class="fas fa-clipboard-list"></i></div><div><h1>İş Emri Malzeme Kullanımları</h1><p>İş emrine bağlı malzeme ve stok düşüm referanslarını inceleyin.</p></div></div>

<partial name="_Menu" />
<div class="sm-card p-3 mb-3"><form method="get" class="form-inline"><input name="search" class="form-control mr-2 mb-2" value="@Model.Search" placeholder="İş emri no veya malzeme..." /><button class="btn btn-primary mb-2">Ara</button></form></div>
<div class="sm-card"><div class="sm-card-title">Kullanım Kayıtları</div><div class="table-responsive"><table class="table table-hover sm-table"><thead><tr><th>Tarih</th><th>İş Emri</th><th>Başlık</th><th>Ambar</th><th>Malzeme</th><th>Kullanılan</th><th>Çıkış Referansı</th></tr></thead><tbody>
@foreach(var x in Model.WorkOrders){<tr><td>@x.Date.ToLocalTime().ToString("dd.MM.yyyy")</td><td class="font-weight-bold">@x.WorkOrderNumber</td><td>@x.WorkOrderTitle</td><td>@x.Warehouse</td><td>@x.Material</td><td>@x.Quantity.ToString("0.####") @x.Unit</td><td>@(string.IsNullOrEmpty(x.MovementReference)?"Henüz ilişkilendirilmemiş":x.MovementReference)</td></tr>}
@if(Model.WorkOrders.Count==0){<tr><td colspan="7" class="text-center text-muted py-5">Kayıt bulunamadı.</td></tr>}
</tbody></table></div></div></div>
