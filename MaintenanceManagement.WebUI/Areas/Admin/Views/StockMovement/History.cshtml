@{ Layout="~/Views/Shared/_AdminLayout.cshtml"; }
@section Styles {<link rel="stylesheet" href="~/css/stock-management.css" asp-append-version="true" />}

@model MaintenanceManagement.Application.DTOs.WarehouseOperations.WarehousePageVm
@{ ViewData["Title"]="Hareket Geçmişi"; }
<div class="container-fluid sm-page">
<div class="sm-heading"><div class="sm-heading-icon"><i class="fas fa-history"></i></div><div><h1>Hareket Geçmişi</h1><p>Giriş, çıkış ve transferlerin tam hareket kayıtları.</p></div></div>

@if(TempData["SuccessMessage"]!=null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}
<partial name="_Menu" />
<div class="sm-card p-3 mb-3"><form method="get" class="form-row align-items-end">
<div class="col-md-4 mb-2"><label>Ambar</label><select name="warehouseId" class="form-control"><option value="">Tüm yetkili ambarlar</option>
@foreach(var w in Model.Warehouses.OrderBy(x => x.Text)) { <option value="@w.Id" selected="@(Model.WarehouseId==w.Id)">@w.Text</option> }</select></div>
<div class="col-md-5 mb-2"><label>Malzeme / Referans</label><input class="form-control" name="search" value="@Model.Search" placeholder="Arama..." /></div>
<div class="col-md-3 mb-2"><button class="btn btn-primary">Filtrele</button><a asp-action="History" class="btn btn-outline-secondary ml-1">Temizle</a></div>
</form></div><div class="sm-card"><div class="sm-card-title">Hareket Kayıtları</div><partial name="_Movements" model="Model.Movements" /></div></div>
